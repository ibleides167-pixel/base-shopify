<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} - {{ shop.name | strip }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0748/0429/7797/files/ChatGPT_Image_26_de_jul._de_2026_17_57_22.png?v=1785103014&width=64">
  <link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/0748/0429/7797/files/ChatGPT_Image_26_de_jul._de_2026_17_57_22.png?v=1785103014&width=180">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'velkrova-refine.css' | asset_url | stylesheet_tag }}
  {{ 'velkrova-tweaks.css' | asset_url | stylesheet_tag }}
  {{ 'velkrova-tune.css' | asset_url | stylesheet_tag }}
  {{ 'velkrova-polish.css' | asset_url | stylesheet_tag }}
  {{ 'velkrova-gallery.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {%- if template.name == 'product' -%}
    <script src="{{ 'velkrova-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if template.name == 'product' and product != blank -%}
    {%- assign pv = product.selected_or_first_available_variant -%}
    {%- assign img = product.featured_image | image_url: width: 1200 -%}
    {%- unless img contains 'http' -%}{%- assign img = img | prepend: 'https:' -%}{%- endunless -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 400 | json }},
      {% if product.featured_image %}"image": [{{ img | json }}],{% endif %}
      {% if pv.sku != blank %}"sku": {{ pv.sku | json }},{% endif %}
      "brand": { "@type": "Brand", "name": {{ shop.name | strip | json }} },
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": "{{ pv.price | divided_by: 100.0 }}",
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": {{ shop.name | strip | json }} }
      }
    }
    </script>
  {%- endif -%}

  {%- if template.name == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Organization",
      "name": {{ shop.name | strip | json }},
      "url": {{ shop.url | json }},
      "logo": "https://cdn.shopify.com/s/files/1/0748/0429/7797/files/ChatGPT_Image_26_de_jul._de_2026_17_29_30.png?v=1785103280"
    }
    </script>
  {%- endif -%}
</head>
<body>
<a class="skip-link" href="#MainContent">Skip to content</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
</body></html>
