{%- comment -%}
  ============================================================
  SHOPPABLE LIFESTYLE — imagem grande com pontos de produto + carrossel lateral
  ============================================================

  O QUE FAZ:
  Duas colunas: à esquerda, até 2 cards de produto empilhados (mesmo
  snippet 'card-product' usado nos carrosséis); à direita, uma foto
  grande de estilo de vida com até 4 "pontos" (hotspots) sobrepostos —
  cada um é um <details>/<summary> que abre um mini card com foto,
  título e preço do produto marcado naquele ponto da imagem.

  ONDE É USADA:
  Seção reutilizável (tem preset) — pensada para a home, entre a
  vitrine de categorias e a segunda vitrine de produtos.

  PRINCIPAIS PARTES:
  - section.blocks tem DOIS tipos misturados no mesmo array:
    'product' (para a coluna da esquerda) e 'hotspot' (para os
    pontos sobre a imagem). Filtramos por block.type em cada loop.
  - Cada hotspot usa position_x/position_y (0-100, em %) para se
    posicionar sobre a imagem via CSS inline (left/top).
  - <details>/<summary> nativo: abre/fecha sem JS. Um pequeno
    <script> só fecha os outros hotspots abertos quando um novo abre
    (evita vários popovers abertos ao mesmo tempo) — comportamento
    puramente cosmético, a interação principal já funciona sem ele.

  OBSERVAÇÕES:
  Sem imagem escolhida no editor, cai no asset de demonstração
  'velkrova-lifestyle.jpg' (gerado para esta base) em vez do
  placeholder genérico do Shopify — assim a seção já nasce com uma
  aparência de loja de verdade.
{%- endcomment -%}
<div class="shoppable-lifestyle page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="shoppable-lifestyle__grid">
    <ul class="shoppable-lifestyle__products" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.product != blank -%}
              {% render 'card-product', card_product: block.settings.product %}
            {%- else -%}
              <div class="card-product">
                <div class="card-product__media">
                  {%- case forloop.index0 | modulo: 3 -%}
                    {%- when 0 -%}{{ 'velkrova-product-serum.png' | asset_url | image_tag: loading: 'lazy', class: 'card-product__image' }}
                    {%- when 1 -%}{{ 'velkrova-product-cream.png' | asset_url | image_tag: loading: 'lazy', class: 'card-product__image' }}
                    {%- when 2 -%}{{ 'velkrova-product-pump.png' | asset_url | image_tag: loading: 'lazy', class: 'card-product__image' }}
                  {%- endcase -%}
                </div>
                <div class="card-product__info"><h3 class="card-product__title">{{ 'onboarding.product_title' | t }}</h3></div>
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="shoppable-lifestyle__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            class: 'shoppable-lifestyle__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 1000px) 50vw, 100vw',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      {%- else -%}
        {{ 'velkrova-lifestyle.jpg' | asset_url | image_tag: loading: 'lazy', class: 'shoppable-lifestyle__image', alt: section.settings.heading | escape }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          {%- assign hotspot_product = block.settings.product -%}
          <details
            class="shoppable-lifestyle__hotspot"
            style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
            data-hotspot
            {{ block.shopify_attributes }}
          >
            <summary class="shoppable-lifestyle__dot" aria-label="{{ hotspot_product.title | default: 'View product' }}"></summary>
            <div class="shoppable-lifestyle__card">
              {%- if hotspot_product != blank -%}
                <a href="{{ hotspot_product.url }}" class="shoppable-lifestyle__card-link">
                  {%- if hotspot_product.featured_media -%}
                    {{ hotspot_product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', class: 'shoppable-lifestyle__card-image', alt: hotspot_product.title | escape }}
                  {%- else -%}
                    {{ 'velkrova-product-serum.png' | asset_url | image_tag: loading: 'lazy', class: 'shoppable-lifestyle__card-image' }}
                  {%- endif -%}
                  <span class="shoppable-lifestyle__card-info">
                    <span class="shoppable-lifestyle__card-title">{{ hotspot_product.title | escape }}</span>
                    {% render 'price', product: hotspot_product, use_variant: false, show_compare: false, price_class: 'shoppable-lifestyle__card-price' %}
                  </span>
                </a>
              {%- else -%}
                <span class="shoppable-lifestyle__card-empty">{{ 'onboarding.product_title' | t }}</span>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .shoppable-lifestyle { padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }

  .shoppable-lifestyle__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 24px; align-items: start; }

  .shoppable-lifestyle__products { display: flex; flex-direction: column; gap: 24px; list-style: none; margin: 0; padding: 0; }

  .shoppable-lifestyle__media { position: relative; border-radius: var(--media-radius); overflow: hidden; }
  .shoppable-lifestyle__image { display: block; width: 100%; height: 100%; min-height: 480px; object-fit: cover; }

  .shoppable-lifestyle__hotspot { position: absolute; transform: translate(-50%, -50%); }
  .shoppable-lifestyle__dot {
    display: flex;
    width: 26px;
    height: 26px;
    list-style: none;
    background-color: var(--color-background);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.35);
  }
  .shoppable-lifestyle__dot::before {
    content: '';
    margin: auto;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
  }
  .shoppable-lifestyle__dot::-webkit-details-marker { display: none; }
  .shoppable-lifestyle__hotspot[open] .shoppable-lifestyle__dot { background-color: var(--color-accent); }
  .shoppable-lifestyle__hotspot[open] .shoppable-lifestyle__dot::before { background-color: var(--color-accent-text); }

  .shoppable-lifestyle__card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    padding: 10px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--media-radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    z-index: 5;
  }
  .shoppable-lifestyle__card-link { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; }
  .shoppable-lifestyle__card-image { width: 48px; height: 48px; object-fit: cover; border-radius: var(--inputs-radius); flex: none; }
  .shoppable-lifestyle__card-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .shoppable-lifestyle__card-title { font-size: var(--f1); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .shoppable-lifestyle__card-price { font-size: var(--f1); opacity: 0.75; }
  .shoppable-lifestyle__card-empty { display: block; padding: 4px; font-size: var(--f1); opacity: 0.6; }

  @media screen and (max-width: 900px) {
    .shoppable-lifestyle__grid { grid-template-columns: 1fr; }
    .shoppable-lifestyle__products { flex-direction: row; }
    .shoppable-lifestyle__products > li { flex: 1; }
    .shoppable-lifestyle__image { min-height: 360px; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.shoppable-lifestyle[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var hotspots = Array.prototype.slice.call(root.querySelectorAll('[data-hotspot]'));
    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('toggle', function () {
        if (!hotspot.open) return;
        hotspots.forEach(function (other) {
          if (other !== hotspot) other.open = false;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Shoppable lifestyle",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROUTINE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Side product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "hotspot",
      "name": "Image hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "position_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position", "default": 50 },
        { "type": "range", "id": "position_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable lifestyle",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "hotspot", "settings": { "position_x": 30, "position_y": 25 } },
        { "type": "hotspot", "settings": { "position_x": 60, "position_y": 55 } }
      ]
    }
  ]
}
{% endschema %}
