{%- liquid
  assign v = product.selected_or_first_available_variant
  assign media_cap = section.settings.media_limit | default: 5
  assign opt1 = product.options_with_values.first.name
  assign is_bundle = false
  if opt1 == 'Pack size' or opt1 == 'Pack'
    assign is_bundle = true
  endif
  assign benefits = product.metafields.custom.key_benefits.value
  if benefits == blank
    assign benefits = product.metafields.custom.benefits.value
  endif
  assign promo = product.metafields.custom.promo_message.value
  assign hero_img = v.featured_image | default: product.featured_image
-%}

{%- comment -%}
  Gallery.
  Desktop: one large image with thumbnails underneath.
  Mobile: full-width swipe strip with dots; thumbnails hidden.

  Variant art is preloaded but never gets a slide of its own: picking a
  colour swaps the visible image rather than lengthening the gallery.
{%- endcomment -%}

<style>
.product-price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:16px 0}
.save-inline{font-size:12px;letter-spacing:.07em;text-transform:uppercase;background:var(--green);color:#fff;padding:6px 11px;border-radius:2px}
.product-description{max-width:none}
.product-description h3{font-family:var(--font-body);letter-spacing:.08em;text-transform:uppercase;margin:28px 0 10px}
.product-description h3:first-child{margin-top:0}
.product-description ul,.product-description ol{padding-left:20px}
.product-description li{margin-bottom:9px}
.bundle{display:grid;gap:10px;margin:18px 0}
.bundle-opt{position:relative;display:block;margin:0}
.bundle-opt input{position:absolute;opacity:0;width:0;height:0}
.bundle-row{display:grid;grid-template-columns:22px 1fr auto;gap:13px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:14px 16px;cursor:pointer;transition:border-color .15s ease,background .15s ease;background:#fff}
.bundle-row:hover{border-color:var(--green)}
.bundle-opt input:checked+.bundle-row{border-color:var(--green);background:#f6faf9;box-shadow:inset 0 0 0 1px var(--green)}
.bundle-opt input:disabled+.bundle-row{opacity:.45;cursor:not-allowed}
.bundle-tick{width:20px;height:20px;border-radius:50%;border:1px solid var(--line);display:inline-block;position:relative}
.bundle-opt input:checked+.bundle-row .bundle-tick{border-color:var(--green);background:var(--green)}
.bundle-opt input:checked+.bundle-row .bundle-tick:after{content:"";position:absolute;left:6px;top:3px;width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.bundle-main strong{display:block;font-size:15px;font-weight:500;line-height:1.3}
.bundle-main small{display:block;font-size:12px;color:var(--muted);margin-top:2px}
.bundle-price{text-align:right}
.bundle-price strong{display:block;font-size:16px;font-weight:600}
.bundle-price em{display:inline-block;font-style:normal;font-size:10px;letter-spacing:.07em;text-transform:uppercase;background:var(--green);color:#fff;padding:3px 7px;border-radius:999px;margin-top:4px}
.bundle-flag{position:absolute;top:-9px;right:14px;background:var(--ink);color:#fff;font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:999px;z-index:2}
/* Palo-Alto-style buy box, in Velkrova colours */
.pdp-pill{display:inline-block;background:var(--cream);color:var(--green);font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;padding:6px 13px;border-radius:999px;margin-bottom:14px}
.pdp-stock{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin:-2px 0 18px}
.pdp-stock__dot{width:9px;height:9px;border-radius:50%;background:#3aa76d;box-shadow:0 0 0 3px rgba(58,167,109,.18)}
.pdp-stock--out .pdp-stock__dot{background:#c0392b;box-shadow:0 0 0 3px rgba(192,57,43,.18)}
.pdp-trust{display:flex;flex-wrap:wrap;gap:14px 26px;margin:0 0 22px;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.pdp-trust__item{display:flex;align-items:center;gap:10px;font-size:13.5px;color:var(--ink)}
.pdp-trust__item svg{width:22px;height:22px;flex:none;stroke:var(--green);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.add-price{margin-left:7px;font-weight:600}
.pdp-accordion{margin-top:28px}
.pdp-accordion .vk-acc + .vk-acc{margin-top:0}
.biw{display:flex;align-items:center;gap:14px;border:1px solid var(--line);border-radius:16px;padding:12px 14px;margin-top:22px;background:#fff}
.biw__media{flex:none;width:76px;height:76px;border-radius:11px;overflow:hidden;background:var(--cream);display:block}
.biw__media img{width:100%;height:100%;object-fit:cover;display:block}
.biw__info{flex:1;min-width:0}
.biw__label{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
.biw__title{display:block;font-weight:600;font-size:14px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px}
.biw__price{font-size:14px;color:var(--ink)}
.biw form{margin:0;flex:none}
.biw__btn{background:var(--green);color:#fff;border:0;border-radius:999px;padding:12px 20px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;cursor:pointer;white-space:nowrap;transition:opacity .2s ease}
.biw__btn:hover{opacity:.88}
@media(max-width:560px){.biw{flex-wrap:wrap}.biw__info{flex:1 1 auto}.biw form{flex:1 1 100%}.biw__btn{width:100%}}
</style>

<section class="product-main">
  <div class="page-width">
    <div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> &rsaquo; {%- if product.collections.first -%} <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> &rsaquo;{%- endif -%} {{ product.title }}</div>
    <div class="product-layout">
      <div class="product-gallery">

        <div class="main-image">
          {%- if hero_img != blank -%}
            <img src="{{ hero_img | image_url: width: 1400 }}" srcset="{{ hero_img | image_url: width: 700 }} 700w, {{ hero_img | image_url: width: 1400 }} 1400w" sizes="(max-width:900px) 100vw, 50vw" alt="{{ product.title | escape }}" width="1400" height="1400" fetchpriority="high" data-product-main-image>
          {%- else -%}
            <div class="placeholder">Product image</div>
          {%- endif -%}
        </div>

        <div class="thumbs">
          {%- for img in product.images limit: media_cap -%}
            <button class="thumb{% if forloop.first %} active{% endif %}" type="button" data-product-thumb data-img-id="{{ img.id }}" data-src="{{ img | image_url: width: 1400 }}" data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 240 }}" alt="{{ product.title | escape }}" width="240" height="240" loading="lazy">
            </button>
          {%- endfor -%}
        </div>

        <div class="vk-mgallery" data-vk-mgallery>
          {%- for img in product.images limit: media_cap -%}
            <img src="{{ img | image_url: width: 1200 }}" srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 1200 }} 1200w" sizes="(max-width:900px) 100vw, 50vw" width="1200" height="1200" alt="{{ product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" data-img-id="{{ img.id }}"{% if forloop.first %} data-vk-slot="first"{% endif %}>
          {%- endfor -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="vk-mdots" data-vk-mdots>
            {%- for img in product.images limit: media_cap -%}
              <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-vk-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="vk-variant-preload" aria-hidden="true" hidden>
          {%- for variant in product.variants -%}
            {%- if variant.featured_image != blank -%}
              <img src="{{ variant.featured_image | image_url: width: 900 }}" alt="" loading="lazy" width="1" height="1">
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="product-info">
        {%- assign urgency = '' -%}
        {%- if product.tags contains 'best-seller' or product.tags contains 'Best seller' -%}{%- assign urgency = 'Selling fast' -%}{%- endif -%}
        {%- if urgency != blank -%}<span class="pdp-pill">{{ urgency }}</span>{%- endif -%}
        <h1 class="product-title">{{ product.title }}</h1>

        {%- if promo != blank -%}<p class="vk-promo">{{ promo }}</p>{%- endif -%}

        <div class="product-price">
          <span data-product-price>{{ v.price | money }}</span>
          <span class="compare" data-product-compare{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}</span>
          <span class="save-inline" data-product-save{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{% if v.compare_at_price > v.price %}Save {{ v.compare_at_price | minus: v.price | money }}{% endif %}</span>
        </div>

        <p class="pdp-stock{% unless product.available %} pdp-stock--out{% endunless %}"><span class="pdp-stock__dot"></span>{% if product.available %}In stock, ready to ship{% else %}Currently out of stock{% endif %}</p>

        <div class="pdp-trust">
          <span class="pdp-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21c5-2 8.5-6 8.5-11.5V5L12 2.5 3.5 5v4.5C3.5 15 7 19 12 21z"/><path d="M8.6 11.4l2.3 2.3 4.5-5"/></svg><span>{{ section.settings.trust_1 | default: 'Cruelty-free & vegan' }}</span></span>
          <span class="pdp-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c2.4 3.2 5.4 4.2 7.5 4.2 0 7.4-3.3 11.6-7.5 14.3C7.8 18.8 4.5 14.6 4.5 7.2 6.6 7.2 9.6 6.2 12 3z"/></svg><span>{{ section.settings.trust_2 | default: 'Dermatologist tested' }}</span></span>
        </div>

        {%- if benefits and benefits.size > 0 -%}
          <ul class="vk-benefits">
            {%- for b in benefits limit: 3 -%}
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.4 3.4 7.6-7.8"/></svg><span>{{ b }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {% form 'product', product, class: 'product-form' %}
          {%- unless product.has_only_default_variant -%}
            {%- if is_bundle -%}
              {%- liquid
                assign base_unit = 0
                assign best_pct = 0
                for variant in product.variants
                  assign q = variant.title | split: ' ' | first | plus: 0
                  if q < 1
                    assign q = 1
                  endif
                  assign u = variant.price | divided_by: q
                  if u > base_unit
                    assign base_unit = u
                  endif
                endfor
                for variant in product.variants
                  assign q = variant.title | split: ' ' | first | plus: 0
                  if q < 1
                    assign q = 1
                  endif
                  assign u = variant.price | divided_by: q
                  assign pct = 0
                  if base_unit > 0 and u < base_unit
                    assign pct = base_unit | minus: u | times: 100 | divided_by: base_unit
                  endif
                  if pct > best_pct
                    assign best_pct = pct
                  endif
                endfor
              -%}
              <span class="variant-label">Choose your bundle</span>
              <div class="bundle">
                {%- for i in (1..24) -%}
                  {%- for variant in product.variants -%}
                    {%- assign q = variant.title | split: ' ' | first | plus: 0 -%}
                    {%- if q < 1 -%}{%- assign q = 1 -%}{%- endif -%}
                    {%- if q == i -%}
                      {%- assign u = variant.price | divided_by: q -%}
                      {%- assign pct = 0 -%}
                      {%- if base_unit > 0 and u < base_unit -%}{%- assign pct = base_unit | minus: u | times: 100 | divided_by: base_unit -%}{%- endif -%}
                      <label class="bundle-opt">
                        {%- if pct > 0 and pct == best_pct -%}<span class="bundle-flag">Best value</span>{%- endif -%}
                        <input type="radio" name="variant-choice" value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}" data-save="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money }}{% endif %}" data-img-id="{% if variant.featured_image %}{{ variant.featured_image.id }}{% endif %}" data-img-src="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1400 }}{% endif %}"{% if variant == v %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                        <span class="bundle-row">
                          <span class="bundle-tick"></span>
                          <span class="bundle-main"><strong>{{ variant.title }}</strong><small>{{ u | money }} each</small></span>
                          <span class="bundle-price"><strong>{{ variant.price | money }}</strong>{% if pct > 0 %}<em>Save {{ pct }}%</em>{% endif %}</span>
                        </span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="variant-options">
                <span class="variant-label">{{ product.options_with_values | map: 'name' | join: ' / ' }}</span>
                <div class="variant-pills">
                  {%- for variant in product.variants -%}
                    <label class="variant-pill">
                      <input type="radio" name="variant-choice" value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}" data-save="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money }}{% endif %}" data-img-id="{% if variant.featured_image %}{{ variant.featured_image.id }}{% endif %}" data-img-src="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1400 }}{% endif %}"{% if variant == v %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                      <span>{{ variant.title }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endunless -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
          <span class="variant-label">Quantity</span>
          <div class="qty-stepper">
            <button type="button" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <input class="qty" id="Quantity" name="quantity" type="number" min="1" max="99" value="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="btn" type="submit" data-main-add{% unless product.available %} disabled{% endunless %}>{% render 'icon', name: 'bag' %}<span>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</span>{% if product.available %}<span class="add-price" data-add-price>&middot; {{ v.price | money }}</span>{% endif %}</button>
          {{ form | payment_button }}
        {% endform %}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="payment-row product-payments">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}</div>
        {%- endif -%}

        {%- if section.settings.show_buy_with -%}
          {%- assign biw = blank -%}
          {%- assign biw_src = collections['best-sellers'] -%}
          {%- if biw_src == blank or biw_src.products_count < 2 -%}{%- assign biw_src = product.collections.first -%}{%- endif -%}
          {%- for p in biw_src.products -%}
            {%- if p.id != product.id and p.available -%}{%- assign biw = p -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- if biw != blank -%}
            <div class="biw">
              <a class="biw__media" href="{{ biw.url }}">{%- if biw.featured_image != blank -%}<img src="{{ biw.featured_image | image_url: width: 200 }}" alt="{{ biw.title | escape }}" width="200" height="200" loading="lazy">{%- endif -%}</a>
              <div class="biw__info">
                <span class="biw__label">Buy it with</span>
                <a class="biw__title" href="{{ biw.url }}">{{ biw.title }}</a>
                <span class="biw__price">{{ biw.price | money }}</span>
              </div>
              {%- form 'product', biw -%}
                <input type="hidden" name="id" value="{{ biw.selected_or_first_available_variant.id }}">
                <button class="biw__btn" type="submit">Quick add</button>
              {%- endform -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="pdp-accordion">
          <div class="vk-acc">
            {%- if product.description != blank -%}
              <details class="vk-acc__item" open>
                <summary><span>Description</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg></summary>
                <div class="vk-acc__body description-content">{{ product.description }}</div>
              </details>
            {%- endif -%}
          </div>
          {% render 'vk-product-accordion' %}
        </div>
      </div>
    </div>
  </div>
</section>

<div class="marquee marquee--brand" aria-label="Store benefits">
  <div class="marquee-track">
    {%- for pass in (1..6) -%}
      <div class="marquee-group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        <span class="marquee-item">{% render 'icon', name: 'truck' %}<span>Free UK delivery on every order</span></span>
        <span class="marquee-item">{% render 'icon', name: 'return' %}<span>30-day returns</span></span>
        <span class="marquee-item">{% render 'icon', name: 'pin' %}<span>Tracked shipping</span></span>
        <span class="marquee-item">{% render 'icon', name: 'shield' %}<span>Secure checkout</span></span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% render 'vk-pdp-editorial', section: section %}

{%- if product.available -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="s-info">
    <span class="s-title">{{ product.title }}</span>
    <span class="s-price" data-sticky-price>{{ v.price | money }}</span>
  </div>
  <button class="btn" type="button" data-sticky-add>Add to cart</button>
</div>
{%- endif -%}

<script>
(function(){
  var choices = document.querySelectorAll('input[name="variant-choice"]');
  var idField = document.querySelector('[data-variant-id]');
  var priceEl = document.querySelector('[data-product-price]');
  var cmp = document.querySelector('[data-product-compare]');
  var sav = document.querySelector('[data-product-save]');
  var mainImg = document.querySelector('[data-product-main-image]');
  var thumbs = document.querySelectorAll('[data-product-thumb]');
  var strip = document.querySelector('[data-vk-mgallery]');
  var slides = strip ? strip.querySelectorAll('img') : [];
  var firstSlide = strip ? strip.querySelector('[data-vk-slot="first"]') : null;
  var dotWrap = document.querySelector('[data-vk-mdots]');
  var stickyPrice = document.querySelector('[data-sticky-price]');
  var addPrice = document.querySelector('[data-add-price]');

  var slideDefault = firstSlide ? { src: firstSlide.src, srcset: firstSlide.srcset } : null;

  function setMain(src){
    if (!mainImg || !src) return;
    mainImg.removeAttribute('srcset');
    mainImg.src = src;
  }

  function markThumb(id){
    Array.prototype.forEach.call(thumbs, function (t) {
      t.classList.toggle('active', !!id && t.dataset.imgId === id);
    });
  }

  function markDot(i){
    if (!dotWrap) return;
    var dots = dotWrap.querySelectorAll('button');
    Array.prototype.forEach.call(dots, function (d, x) { d.classList.toggle('is-on', x === i); });
  }

  /* Variant selected: swap the large image, and reuse the first slide on
     mobile so the gallery never grows because of a colour choice. */
  function showVariantImage(id, src){
    if (!src) return;
    setMain(src);
    markThumb(id);
    if (firstSlide) {
      firstSlide.removeAttribute('srcset');
      firstSlide.src = src;
      if (strip) strip.scrollTo({ left: 0, behavior: 'smooth' });
      markDot(0);
    }
  }

  Array.prototype.forEach.call(choices, function (input) {
    input.addEventListener('change', function () {
      if (idField) idField.value = input.value;
      if (priceEl) priceEl.textContent = input.dataset.price || '';
      if (stickyPrice) stickyPrice.textContent = input.dataset.price || '';
      if (addPrice) addPrice.textContent = input.dataset.price ? ('· ' + input.dataset.price) : '';
      if (cmp) { cmp.textContent = input.dataset.compare || ''; cmp.hidden = !input.dataset.compare; }
      if (sav) { sav.textContent = input.dataset.save ? ('Save ' + input.dataset.save) : ''; sav.hidden = !input.dataset.save; }
      showVariantImage(input.dataset.imgId, input.dataset.imgSrc);
    });
  });

  /* Thumbnail clicked: restore the gallery's own image. */
  Array.prototype.forEach.call(thumbs, function (t) {
    t.addEventListener('click', function () {
      var i = parseInt(t.dataset.index, 10) || 0;
      setMain(t.dataset.src);
      markThumb(t.dataset.imgId);
      markDot(i);
      if (i === 0 && firstSlide && slideDefault) {
        firstSlide.src = slideDefault.src;
        if (slideDefault.srcset) firstSlide.srcset = slideDefault.srcset;
      }
      if (strip && slides[i]) {
        strip.scrollTo({ left: slides[i].offsetLeft - strip.offsetLeft, behavior: 'smooth' });
      }
    });
  });

  /* Dots drive the mobile strip. */
  if (strip && dotWrap) {
    var dots = dotWrap.querySelectorAll('button');
    Array.prototype.forEach.call(dots, function (dot) {
      dot.addEventListener('click', function () {
        var i = parseInt(dot.dataset.vkDot, 10) || 0;
        if (!slides[i]) return;
        strip.scrollTo({ left: slides[i].offsetLeft - strip.offsetLeft, behavior: 'smooth' });
      });
    });

    strip.addEventListener('scroll', function () {
      if (!dots.length) return;
      var i = Math.round(strip.scrollLeft / (strip.scrollWidth / dots.length));
      markDot(i);
    }, { passive: true });
  }

  var qtyInput = document.getElementById('Quantity');
  var steps = document.querySelectorAll('[data-qty-step]');
  function syncQty(){
    if (!qtyInput) return;
    var n = parseInt(qtyInput.value, 10);
    if (isNaN(n) || n < 1) n = 1;
    if (n > 99) n = 99;
    qtyInput.value = n;
    Array.prototype.forEach.call(steps, function (b) {
      if (b.dataset.qtyStep === '-1') b.disabled = n <= 1;
      if (b.dataset.qtyStep === '1') b.disabled = n >= 99;
    });
  }
  Array.prototype.forEach.call(steps, function (b) {
    b.addEventListener('click', function () {
      if (!qtyInput) return;
      qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + Number(b.dataset.qtyStep);
      syncQty();
    });
  });
  if (qtyInput) { qtyInput.addEventListener('change', syncQty); qtyInput.addEventListener('blur', syncQty); syncQty(); }

  var bar = document.querySelector('[data-sticky-atc]');
  var mainBtn = document.querySelector('[data-main-add]');
  if (bar && mainBtn) {
    var stickyBtn = bar.querySelector('[data-sticky-add]');
    if (stickyBtn) stickyBtn.addEventListener('click', function () {
      var form = mainBtn.closest('form');
      if (!form) return;
      if (form.requestSubmit) form.requestSubmit(mainBtn); else mainBtn.click();
