{%- comment -%}
  Velkrova "10-minute routine" — the brand's core promise as a simple,
  honest four-step ritual. No photography required (numbered steps only),
  so it never renders an empty image frame. Fully editable in the editor.
{%- endcomment -%}

<section class="vk-routine">
  <div class="page-width">
    <div class="vk-routine__head">
      {%- if section.settings.eyebrow != blank -%}<span class="vk-routine__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vk-routine__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="vk-routine__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <ol class="vk-routine__grid">
      {%- for block in section.blocks -%}
        <li class="vk-routine__step" {{ block.shopify_attributes }}>
          <span class="vk-routine__num">{{ block.settings.number | default: forloop.index }}</span>
          <h3 class="vk-routine__step-title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="vk-routine__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="vk-routine__cta">
        <a class="btn" href="{{ section.settings.button_link | default: '/collections/best-sellers-1' }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .vk-routine{padding:clamp(44px,5.4vw,80px) 0;background:var(--cream,#f5f1eb)}
  .vk-routine__head{max-width:660px;margin:0 auto clamp(28px,3.4vw,44px);text-align:center}
  .vk-routine__eyebrow{display:inline-block;margin-bottom:12px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#64706d);font-weight:500}
  .vk-routine__title{margin:0;font-family:var(--font-heading,'Marcellus',Georgia,serif);font-weight:400;font-size:clamp(26px,3vw,40px);line-height:1.08;letter-spacing:-.015em}
  .vk-routine__sub{margin:14px auto 0;max-width:52ch;font-size:15px;line-height:1.6;color:var(--muted,#64706d)}
  .vk-routine__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(16px,2vw,26px)}
  .vk-routine__step{position:relative;display:flex;flex-direction:column;gap:10px;padding-top:22px;border-top:2px solid var(--green,#073f3a)}
  .vk-routine__num{font-family:var(--font-heading,'Marcellus',Georgia,serif);font-size:clamp(30px,3.4vw,44px);line-height:1;color:var(--green,#073f3a)}
  .vk-routine__step-title{margin:0;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
  .vk-routine__text{margin:0;font-size:14px;line-height:1.55;color:var(--muted,#64706d)}
  .vk-routine__cta{text-align:center;margin-top:clamp(28px,3.4vw,44px)}
  @media(max-width:760px){.vk-routine__grid{grid-template-columns:1fr 1fr;gap:22px 16px}}
  @media(max-width:460px){.vk-routine__grid{grid-template-columns:1fr}.vk-routine__step{padding-top:16px}}
</style>

{% schema %}
{
  "name": "10-minute routine",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE 10-MINUTE ROUTINE"},
    {"type":"text","id":"heading","label":"Heading","default":"Beauty care that fits into real life"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"You do not need an hour-long routine to make time for yourself."},
    {"type":"text","id":"button_label","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks": [
    {"type":"step","name":"Step","settings":[
      {"type":"text","id":"number","label":"Number"},
      {"type":"text","id":"title","label":"Title","default":"Cleanse"},
      {"type":"textarea","id":"text","label":"Text","default":"Start on clean, dry skin so every step works as it should."}
    ]}
  ],
  "max_blocks": 6,
  "presets": [
    {"name":"10-minute routine","blocks":[
      {"type":"step","settings":{"number":"01","title":"Cleanse","text":"Start on clean, dry skin so every step works as it should."}},
      {"type":"step","settings":{"number":"02","title":"Choose your device","text":"Pick the tool for tonight — LED, microcurrent, massage or gua sha."}},
      {"type":"step","settings":{"number":"03","title":"Relax for ten minutes","text":"Most devices are hands-free, so you can read or wind down while they work."}},
      {"type":"step","settings":{"number":"04","title":"Continue your routine","text":"Follow with your serum or moisturiser and you are done."}}
    ]}
  ]
}
{% endschema %}
