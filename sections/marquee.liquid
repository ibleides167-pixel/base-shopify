<section class="marquee{% if section.settings.brand %} marquee--brand{% endif %}" aria-label="{{ section.settings.label }}">
  <div class="marquee-track">
    {%- for pass in (1..6) -%}
      <div class="marquee-group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- for block in section.blocks -%}
          <span class="marquee-item"{% if forloop.parentloop.first %} {{ block.shopify_attributes }}{% endif %}>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}{"name":"Scrolling benefits","settings":[{"type":"text","id":"label","label":"Accessible label","default":"Store benefits"},{"type":"checkbox","id":"brand","label":"Use brand colour background","default":false}],"blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Free UK delivery"},{"type":"select","id":"icon","label":"Icon","default":"truck","options":[{"value":"truck","label":"Delivery"},{"value":"return","label":"Returns"},{"value":"pin","label":"Tracking"},{"value":"shield","label":"Secure"}]}]}],"presets":[{"name":"Scrolling benefits","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]}{% endschema %}
