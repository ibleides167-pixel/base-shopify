{%- comment -%}
  ============================================================
  MARQUEE — faixa de benefícios em loop contínuo
  ============================================================

  O QUE FAZ:
  Uma linha fina com ícone + texto (ex: "Frete grátis", "Troca em
  30 dias") que rola infinitamente da direita pra esquerda via CSS
  animation. Pausa no hover/foco (também respeita
  prefers-reduced-motion, tratado no CSS global).

  ONDE É USADA:
  Seção reutilizável (tem preset com 4 blocos) — comum logo abaixo
  do hero.

  PRINCIPAIS PARTES:
  - O conteúdo dos blocks é duplicado 3x (.marquee__group) pra criar
    um loop sem costura: a animação anda 33.333% e reinicia.
  - Settings: label (acessibilidade), brand (fundo na cor de destaque)

  OBSERVAÇÕES:
  aria-hidden nas cópias extras evita repetir o conteúdo pra leitores
  de tela.
{%- endcomment -%}
<section class="marquee{% if section.settings.brand %} marquee--brand{% endif %}" aria-label="{{ section.settings.label | escape }}">
  <div class="marquee__track">
    {%- for pass in (1..3) -%}
      <div class="marquee__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- for block in section.blocks -%}
          <span class="marquee__item"{% if forloop.parentloop.first %} {{ block.shopify_attributes }}{% endif %}>
            {% render 'icon', name: block.settings.icon %}
            <span>{{ block.settings.text | escape }}</span>
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .marquee { overflow: hidden; background: var(--color-background); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 15px 0; }
  .marquee--brand { background: var(--color-accent); border-color: var(--color-accent); }
  .marquee--brand .marquee__item { color: var(--color-accent-text); }
  .marquee--brand .marquee__item svg { stroke: var(--color-accent-text); }

  .marquee__track { display: flex; width: max-content; animation: marquee-scroll 30s linear infinite; }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }
  .marquee__group { display: flex; align-items: center; gap: 48px; padding-right: 48px; flex: 0 0 auto; }
  .marquee__item { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; font-size: var(--f1); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text); }
  .marquee__item svg { flex: none; stroke: var(--color-accent); }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.3333%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
</style>

{% schema %}
{
  "name": "Scrolling benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Store benefits" },
    { "type": "checkbox", "id": "brand", "label": "Use accent colour background", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "pin", "label": "Tracking" },
            { "value": "shield", "label": "Secure" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling benefits",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping", "icon": "truck" } },
        { "type": "item", "settings": { "text": "30-day returns", "icon": "return" } },
        { "type": "item", "settings": { "text": "Tracked shipping", "icon": "pin" } },
        { "type": "item", "settings": { "text": "Secure checkout", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
