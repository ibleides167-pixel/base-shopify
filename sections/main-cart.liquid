<section class="cart"><div class="page-width"><h1 class="section-title">Your cart</h1>{% if cart.item_count == 0 %}<p>Your cart is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{{ item.image | image_url: width: 240 | image_tag }}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div>{{ item.variant.title }}</div><a href="{{ item.url_to_remove }}">Remove</a></div><input class="qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-summary"><p>Subtotal: <strong>{{ cart.total_price | money }}</strong></p><button class="btn secondary" type="submit" name="update">Update cart</button><button class="btn" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
