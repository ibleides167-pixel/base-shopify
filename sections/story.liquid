<section class="story"><div class="page-width"><div class="story-grid">
  <div class="story-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {%- elsif section.settings.image_url != blank -%}
      <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
  </div>
  <div class="story-copy">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="story-points">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: '/collections/best-sellers-1' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div></div></section>
{% schema %}{"name":"Story block","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_url","label":"Image URL (fallback)"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE VELKROVA APPROACH"},{"type":"text","id":"heading","label":"Heading","default":"Salon results, ten minutes at a time"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the range"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"point","name":"Point","settings":[{"type":"text","id":"text","label":"Text","default":"Free UK delivery"},{"type":"select","id":"icon","label":"Icon","default":"shield","options":[{"value":"truck","label":"Delivery"},{"value":"return","label":"Returns"},{"value":"pin","label":"Tracking"},{"value":"shield","label":"Secure"}]}]}],"presets":[{"name":"Story block","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]}{% endschema %}
