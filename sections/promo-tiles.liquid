{%- comment -%}
  Promo tiles - one tile per category.
  Image: override > hero product of that category > collection image, so
  each tile always shows something from its own category.
  The offer line is calculated from real compare-at prices in the
  collection; if nothing in it is reduced, the product count is shown
  instead of a discount claim.
{%- endcomment -%}
<section class="section promo-tiles-section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2 class="section-title">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="promo-tiles" style="--cols:{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign hero = block.settings.product
          assign link = block.settings.button_link
          if link == blank and col != blank
            assign link = col.url
          endif
          if link == blank
            assign link = '/collections/all'
          endif
          assign pic = block.settings.image
          if pic == blank and hero != blank
            assign pic = hero.featured_image
          endif
          if pic == blank and col != blank
            assign pic = col.image
          endif
          assign best = 0
          if col != blank
            for p in col.products limit: 50
              for v in p.variants
                if v.compare_at_price > v.price
                  assign d = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
                  if d > best
                    assign best = d
                  endif
                endif
              endfor
            endfor
          endif
        -%}
        <a class="promo-tile promo-tile--{{ block.settings.text_color }}" href="{{ link }}" style="background:{{ block.settings.bg_color }}" {{ block.shopify_attributes }}>
          <div class="promo-tile__copy">
            {%- if col != blank -%}<span class="promo-tile__kicker">{{ col.title }}</span>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3 class="promo-tile__title">{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if best > 0 -%}
              <p class="promo-tile__meta">Up to {{ best }}% off</p>
            {%- elsif col != blank -%}
              <p class="promo-tile__meta">{{ col.products_count }} products</p>
            {%- endif -%}
          </div>
          <div class="promo-tile__foot">
            {%- if block.settings.button_label != blank -%}
              <span class="promo-tile__btn promo-tile__btn--{{ block.settings.button_style }}">{{ block.settings.button_label }}</span>
            {%- endif -%}
            {%- if pic != blank -%}
              <span class="promo-tile__media"><img src="{{ pic | image_url: width: 600 }}" alt="{{ pic.alt | default: block.settings.heading | escape }}" loading="lazy" width="600" height="600"></span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .promo-tiles-section{padding-block:clamp(30px,4vw,64px)}
  .promo-tiles{display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:20px}
  .promo-tile{position:relative;overflow:hidden;border-radius:16px;min-height:340px;padding:28px 26px 24px;display:flex;flex-direction:column;justify-content:space-between;gap:20px;color:var(--ink);transition:transform .35s ease,box-shadow .35s ease}
  .promo-tile:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(15,48,45,.14)}
  .promo-tile--light{color:#fff}
  .promo-tile__kicker{display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:500;opacity:.8;margin-bottom:10px}
  .promo-tile__title{font-family:var(--font-heading);font-weight:400;font-size:clamp(22px,2vw,29px);line-height:1.15;margin:0 0 10px}
  .promo-tile__meta{margin:0;font-size:13px;letter-spacing:.04em;opacity:.85}
  .promo-tile__foot{display:flex;align-items:flex-end;justify-content:space-between;gap:14px}
  .promo-tile__btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;border-radius:999px;white-space:nowrap;transition:transform .25s ease}
  .promo-tile__btn--dark{background:var(--ink);color:#fff}
  .promo-tile__btn--white{background:#fff;color:var(--ink)}
  .promo-tile:hover .promo-tile__btn{transform:translateX(3px)}
  .promo-tile__media{flex:none;width:48%;aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 10px 24px rgba(0,0,0,.14)}
  .promo-tile__media img{width:100%;height:100%;object-fit:contain;transition:transform .5s ease}
  .promo-tile:hover .promo-tile__media img{transform:scale(1.05)}
  @media(max-width:900px){
    .promo-tiles{grid-template-columns:1fr;gap:14px}
    .promo-tile{min-height:0;padding:22px 20px 20px;flex-direction:row;align-items:stretch}
    .promo-tile__copy{flex:1 1 auto;display:flex;flex-direction:column;justify-content:center}
    .promo-tile__foot{flex:none;width:42%;flex-direction:column-reverse;align-items:stretch;justify-content:space-between;gap:12px}
    .promo-tile__media{width:100%}
    .promo-tile__btn{padding:11px 12px;font-size:10.5px}
  }
</style>
{% schema %}
{
  "name": "Promo tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (optional)" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Category collection" },
        { "type": "product", "id": "product", "label": "Hero product (image)" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#073f3a" },
        { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [ { "value": "light", "label": "Light (for dark backgrounds)" }, { "value": "dark", "label": "Dark (for light backgrounds)" } ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Clinic-inspired skin tech" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link (defaults to the collection)" },
        { "type": "select", "id": "button_style", "label": "Button style", "default": "white", "options": [ { "value": "dark", "label": "Dark" }, { "value": "white", "label": "White" } ] }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Promo tiles", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
