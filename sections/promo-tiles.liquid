{%- comment -%}
  Promo tiles — a row of colourful offer banners, each with its own
  background colour, a floating product cut-out, a discount line and a
  button. Styled after the "Unleash Your Inner Beauty" strip.
{%- endcomment -%}
<section class="section promo-tiles-section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2 class="section-title">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="promo-tiles" style="--cols:{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- assign link = block.settings.button_link | default: '/collections/all' -%}
        <a class="promo-tile promo-tile--{{ block.settings.text_color }}"
           href="{{ link }}"
           style="background:{{ block.settings.bg_color }}"
           {{ block.shopify_attributes }}>
          <div class="promo-tile__copy">
            {%- if block.settings.heading != blank -%}<h3 class="promo-tile__title">{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if block.settings.discount != blank -%}<p class="promo-tile__discount">{{ block.settings.discount }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="promo-tile__btn promo-tile__btn--{{ block.settings.button_style }}">{{ block.settings.button_label }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.image != blank -%}
            <img class="promo-tile__img" src="{{ block.settings.image | image_url: width: 700 }}"
                 alt="{{ block.settings.heading | escape }}" loading="lazy" width="700" height="700">
          {%- elsif block.settings.image_url != blank -%}
            <img class="promo-tile__img" src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .promo-tiles-section{padding-block:clamp(30px,4vw,64px)}
  .promo-tiles{display:grid;grid-template-columns:repeat(var(--cols,3),1fr);gap:20px}
  .promo-tile{
    position:relative;overflow:hidden;border-radius:14px;
    min-height:360px;padding:36px 34px;display:flex;flex-direction:column;
    isolation:isolate;color:#12100e;transition:transform .35s ease,box-shadow .35s ease;
  }
  .promo-tile:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(0,0,0,.14)}
  .promo-tile--light{color:#fff}
  .promo-tile__copy{position:relative;z-index:2;max-width:78%}
  .promo-tile__title{font-family:'Marcellus',Georgia,serif;font-weight:400;font-size:clamp(24px,2.2vw,32px);line-height:1.12;margin:0 0 12px}
  .promo-tile__discount{text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:600;margin:0 0 22px;opacity:.9}
  .promo-tile__btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 26px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;border-radius:2px;transition:opacity .25s ease,transform .25s ease}
  .promo-tile__btn--dark{background:#12100e;color:#fff}
  .promo-tile__btn--white{background:#fff;color:#12100e}
  .promo-tile:hover .promo-tile__btn{transform:translateX(3px)}
  .promo-tile__img{
    position:absolute;right:0;bottom:0;z-index:1;
    width:auto;max-width:60%;max-height:66%;object-fit:contain;object-position:right bottom;
    pointer-events:none;filter:drop-shadow(0 10px 22px rgba(0,0,0,.18));
    transition:transform .5s ease;
  }
  .promo-tile:hover .promo-tile__img{transform:scale(1.05)}
  @media(max-width:900px){
    .promo-tiles{grid-template-columns:1fr;gap:16px}
    .promo-tile{min-height:280px;padding:28px 26px}
    .promo-tile__copy{max-width:70%}
  }
</style>
{% schema %}
{
  "name": "Promo tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (optional)" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#F28C28" },
        { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [ { "value": "light", "label": "Light (for dark backgrounds)" }, { "value": "dark", "label": "Dark (for light backgrounds)" } ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Unleash Your Inner Beauty" },
        { "type": "text", "id": "discount", "label": "Discount line", "default": "UP TO 50% DISCOUNT" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "button_style", "label": "Button style", "default": "dark", "options": [ { "value": "dark", "label": "Dark" }, { "value": "white", "label": "White" } ] },
        { "type": "image_picker", "id": "image", "label": "Product image (cut-out)" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Promo tiles",
      "blocks": [
        { "type": "tile", "settings": { "bg_color": "#F28C28", "text_color": "light", "heading": "Unleash Your Inner Beauty", "discount": "UP TO 50% DISCOUNT", "button_style": "dark" } },
        { "type": "tile", "settings": { "bg_color": "#B7A98C", "text_color": "light", "heading": "Embrace Your Uniqueness", "discount": "UP TO 30% DISCOUNT", "button_style": "white" } },
        { "type": "tile", "settings": { "bg_color": "#E39B8B", "text_color": "light", "heading": "Reveal Your Beauty", "discount": "UP TO 50% DISCOUNT", "button_style": "dark" } }
      ]
    }
  ]
}
{% endschema %}
