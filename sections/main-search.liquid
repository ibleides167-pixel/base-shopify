<section class="section"><div class="page-width"><h1 class="section-title">Search</h1><form class="search-form" action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><button class="btn">Search</button></form>{% if search.performed %}<div class="grid products">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>No results found.</p>{% endfor %}</div>{% endif %}</div></section>{% schema %}{"name":"Main search","settings":[]}{% endschema %}
