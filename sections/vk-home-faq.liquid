{%- comment -%}
  Velkrova home FAQ. Answers the three questions cold traffic asks
  before it looks at a single product.
{%- endcomment -%}

<section class="vk-homefaq">
  <div class="page-width">
    <div class="vk-homefaq__grid">
      <div class="vk-homefaq__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vk-homefaq__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="vk-homefaq__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="vk-homefaq__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="vk-homefaq__list vk-acc">
        {%- for block in section.blocks -%}
          <details class="vk-acc__item"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question }}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg>
            </summary>
            <div class="vk-acc__body">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .vk-homefaq{padding:clamp(40px,5vw,72px) 0;background:var(--cream,#f5f1eb)}
  .vk-homefaq__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(28px,4vw,64px);align-items:start}
  .vk-homefaq__eyebrow{
    display:inline-block;margin-bottom:12px;font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--muted,#7d7a74);font-weight:500;
  }
  .vk-homefaq__title{
    margin:0;font-family:var(--font-heading,'Marcellus',Georgia,serif);font-weight:400;
    font-size:clamp(24px,2.6vw,32px);line-height:1.1;letter-spacing:-.015em;
  }
  .vk-homefaq__sub{margin:14px 0 0;max-width:40ch;font-size:15px;line-height:1.6;color:var(--muted,#7d7a74)}
  .vk-homefaq .vk-acc{border-top:1px solid var(--line,#e8e3dc)}
  @media(max-width:900px){
    .vk-homefaq__grid{grid-template-columns:1fr;gap:22px}
  }
</style>

{% schema %}{"name":"Home FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEFORE YOU BUY"},{"type":"text","id":"heading","label":"Heading","default":"The questions we get most"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Straight answers, including the ones about delivery."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How long will my order take?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Orders are typically delivered within 14 to 20 days.</p>"}]}],"presets":[{"name":"Home FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
