{%- comment -%}
  FAQ section (used on the product page, works anywhere).
  Native <details>/<summary>: opens and closes without JavaScript on
  mobile and desktop. On a product page the product's own FAQ
  (custom.faq metafield, JSON list of {q, a}) is shown first, then the
  store-wide questions from the blocks below.
{%- endcomment -%}
{%- liquid
  assign pfaq = blank
  assign has_pfaq = false
  if product and section.settings.use_product_faq
    assign pfaq = product.metafields.custom.faq.value
    if pfaq and pfaq.size > 0
      assign has_pfaq = true
    endif
  endif
-%}
<section class="vk-pfaq">
  <div class="page-width">
    <div class="vk-pfaq__grid">
      <div class="vk-pfaq__head">
        {%- if section.settings.eyebrow != blank -%}<span class="vk-pfaq__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="vk-pfaq__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="vk-pfaq__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      <div class="vk-acc">
        {%- if has_pfaq -%}
          {%- for item in pfaq -%}
            {%- if item.q != blank -%}
              <details class="vk-acc__item"{% if forloop.first %} open{% endif %}>
                <summary><span>{{ item.q }}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg></summary>
                <div class="vk-acc__body"><p>{{ item.a }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          <details class="vk-acc__item"{% if forloop.first and has_pfaq == false %} open{% endif %} {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question }}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg></summary>
            <div class="vk-acc__body">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<style>
  .vk-pfaq{padding:clamp(40px,5vw,72px) 0;background:#fff;border-top:1px solid var(--line)}
  .vk-pfaq__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(28px,4vw,64px);align-items:start}
  .vk-pfaq__eyebrow{display:inline-block;margin-bottom:12px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:500}
  .vk-pfaq__title{margin:0;font-family:var(--font-heading);font-weight:400;font-size:clamp(24px,2.6vw,32px);line-height:1.1;letter-spacing:-.015em}
  .vk-pfaq__sub{margin:14px 0 0;max-width:40ch;font-size:15px;line-height:1.6;color:var(--muted)}
  @media(min-width:901px){.vk-pfaq__head{position:sticky;top:110px}}
  @media(max-width:900px){.vk-pfaq__grid{grid-template-columns:1fr;gap:20px}.vk-pfaq__head{text-align:left}}
</style>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},{"type":"textarea","id":"subheading","label":"Subheading"},{"type":"checkbox","id":"use_product_faq","label":"On product pages, show the product's own FAQ first","default":true}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How long does delivery take?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Orders are typically delivered within 5 to 9 business days.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
