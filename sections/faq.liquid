<section class="section"><div class="page-width"><div class="section-head"><h2 class="section-title">{{ section.settings.heading }}</h2></div><div class="faq">{% for block in section.blocks %}<div class="faq-item" {{ block.shopify_attributes }}><button class="faq-question" data-accordion aria-expanded="false">{{ block.settings.question }}<span>+</span></button><div class="faq-answer">{{ block.settings.answer }}</div></div>{% endfor %}</div></div></section>{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How long does shipping take?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add your answer here.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
