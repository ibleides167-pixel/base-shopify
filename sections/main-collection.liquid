<section>
  <div class="collection-header">
    <div class="page-width">
      <h1 class="section-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="collection-header__text">{{ collection.description }}</div>{% endif %}
    </div>
  </div>
  <div class="page-width">
    <div class="grid collection-grid">
      {% paginate collection.products by 24 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>No products found.</p>
        {% endfor %}
        {% if paginate.pages > 1 %}
          <div class="pagination">{{ paginate | default_pagination }}</div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

<style>
  /* Text-only collection header. The background-image banner was removed:
     the artwork sat behind the title and made it unreadable. */
  .collection-header{
    background:none!important;
    min-height:0!important;
    padding-block:clamp(20px,3vw,40px) clamp(14px,2vw,24px);
    text-align:center;
  }
  .collection-header .section-title{margin:0}
  .collection-header__text{
    margin:10px auto 0;max-width:58ch;
    font-size:15px;line-height:1.6;color:var(--muted,#7d7a74);
  }
  .collection-header__text p{margin:0}
</style>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
