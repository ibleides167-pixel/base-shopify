<section>
  <div class="page-width">
    <div class="collection-hero{% if collection.image %} has-image{% endif %}">
      <div class="collection-hero__copy">
        <nav class="collection-hero__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> &rsaquo; <a href="/collections/all">Shop</a></nav>
        <h1 class="section-title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="collection-hero__text">{{ collection.description }}</div>{%- endif -%}
        <span class="collection-hero__count">{{ collection.products_count }} products</span>
      </div>
      {%- if collection.image -%}
        <div class="collection-hero__media">
          <img src="{{ collection.image | image_url: width: 1000 }}" srcset="{{ collection.image | image_url: width: 600 }} 600w, {{ collection.image | image_url: width: 1000 }} 1000w" sizes="(max-width:900px) 100vw, 40vw" alt="{{ collection.image.alt | default: collection.title | escape }}" width="1000" height="1000" fetchpriority="high">
        </div>
      {%- endif -%}
    </div>
    <div class="grid collection-grid">
      {% paginate collection.products by 24 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>No products found.</p>
        {% endfor %}
        {% if paginate.pages > 1 %}
          <div class="pagination">{{ paginate | default_pagination }}</div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

<style>
  .collection-hero{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;margin:clamp(18px,3vw,36px) 0 clamp(8px,1.5vw,16px);padding:clamp(24px,3.5vw,44px);background:var(--cream);border-radius:16px;text-align:center}
  .collection-hero.has-image{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);text-align:left;padding:0 0 0 clamp(24px,4vw,56px);overflow:hidden}
  .collection-hero__crumbs{font-size:12px;color:var(--muted);margin-bottom:12px}
  .collection-hero .section-title{margin:0}
  .collection-hero__text{margin:12px 0 0;max-width:58ch;font-size:15px;line-height:1.65;color:#3d4b48}
  .collection-hero:not(.has-image) .collection-hero__text{margin-inline:auto}
  .collection-hero__text p{margin:0}
  .collection-hero__count{display:inline-block;margin-top:16px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .collection-hero__media{aspect-ratio:4/3;height:100%;max-height:360px;width:100%;overflow:hidden}
  .collection-hero__media img{width:100%;height:100%;object-fit:cover}
  .collection-grid{padding-top:clamp(22px,3vw,40px)}
  @media(max-width:900px){
    .collection-hero.has-image{grid-template-columns:1fr;padding:0;gap:0}
    .collection-hero__media{order:-1;max-height:none;aspect-ratio:16/9}
    .collection-hero.has-image .collection-hero__copy{padding:22px 20px 24px}
  }
</style>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
