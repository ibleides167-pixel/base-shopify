{%- comment -%}
  Velkrova promo tiles: three full-bleed image tiles side by side, the
  centre one wider, each with a short headline, a discount line and a
  button. Mirrors the classic "3-tile promo banner" pattern.
{%- endcomment -%}

<section class="vk-promo">
  <div class="page-width">
    <div class="vk-promo__grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign target = block.settings.link -%}
        {%- if target == blank and col != blank -%}{%- assign target = col.url -%}{%- endif -%}
        <a class="vk-promo__tile" href="{{ target | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign tile_h = 900 | divided_by: block.settings.image.aspect_ratio | round -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w" sizes="(max-width: 900px) 90vw, 30vw" alt="{{ block.settings.heading | escape }}" loading="lazy" width="900" height="{{ tile_h }}">
          {%- endif -%}
          <div class="vk-promo__overlay">
            <h3>{{ block.settings.heading }}</h3>
            {%- if block.settings.discount != blank -%}<span class="vk-promo__discount">{{ block.settings.discount }}</span>{%- endif -%}
            <span class="vk-promo__btn">{{ block.settings.button_label | default: 'Shop now' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .vk-promo{padding-block:clamp(20px,3vw,40px)}
  .vk-promo__grid{display:grid;grid-template-columns:1fr 1.7fr 1fr;gap:16px}
  .vk-promo__tile{
    position:relative;display:block;border-radius:14px;overflow:hidden;
    min-height:360px;background:var(--sand,#efe1cc);
  }
  .vk-promo__tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .vk-promo__overlay{
    position:relative;z-index:1;height:100%;min-height:360px;
    display:flex;flex-direction:column;justify-content:flex-end;gap:10px;
    padding:24px;color:#fff;
    background:linear-gradient(0deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.15) 45%,rgba(0,0,0,0) 70%);
  }
  .vk-promo__overlay h3{margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);font-weight:700;font-size:clamp(19px,2vw,26px);line-height:1.15}
  .vk-promo__discount{font-size:12px;letter-spacing:.06em;text-transform:uppercase;opacity:.92}
  .vk-promo__btn{
    display:inline-block;align-self:flex-start;margin-top:6px;
    background:#fff;color:#111;font-size:12px;font-weight:700;
    letter-spacing:.04em;text-transform:uppercase;padding:10px 18px;border-radius:999px;
  }

  @media(max-width:900px){
    .vk-promo__grid{
      grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:80%;
      gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;
      -webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px;
    }
    .vk-promo__grid::-webkit-scrollbar{display:none}
    .vk-promo__tile{scroll-snap-align:start}
    .vk-promo__tile,.vk-promo__overlay{min-height:280px}
  }
</style>

{% schema %}{"name":"Promo tiles","blocks":[{"type":"tile","name":"Tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Unleash your inner beauty"},{"type":"text","id":"discount","label":"Discount line","default":"UP TO 50% OFF"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Promo tiles","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]}{% endschema %}
