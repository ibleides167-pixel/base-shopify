{%- comment -%}
  Velkrova promo tiles: three product tiles side by side, the centre one
  wider, each showing a real product photo on a soft tint with a short
  headline, a discount line and a button in a solid colour footer band -
  built for real catalogue photos (usually on white), not full-bleed
  lifestyle images, so text never sits directly on top of a photo.
{%- endcomment -%}

<section class="vk-promo">
  <div class="page-width">
    <div class="vk-promo__grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- assign img = block.settings.image | default: p.featured_image -%}
        {%- assign target = block.settings.link -%}
        {%- if target == blank and p != blank -%}{%- assign target = p.url -%}{%- elsif target == blank and col != blank -%}{%- assign target = col.url -%}{%- endif -%}
        <a class="vk-promo__tile vk-promo__tile--{% cycle 'a', 'b', 'c' %}" href="{{ target | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <div class="vk-promo__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.heading, class: 'vk-promo__img' }}
            {%- endif -%}
          </div>
          <div class="vk-promo__foot">
            <h3>{{ block.settings.heading }}</h3>
            {%- if block.settings.discount != blank -%}<span class="vk-promo__discount">{{ block.settings.discount }}</span>{%- endif -%}
            <span class="vk-promo__btn">{{ block.settings.button_label | default: 'Shop now' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .vk-promo{padding-block:clamp(20px,3vw,40px)}
  .vk-promo__grid{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:16px}
  .vk-promo__tile{
    display:flex;flex-direction:column;border-radius:14px;overflow:hidden;
    background:#fff;border:1px solid var(--line,#e7e0d3);
    transition:transform .2s ease,box-shadow .2s ease;
  }
  .vk-promo__tile:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(0,0,0,.08)}
  .vk-promo__media{
    flex:1 1 auto;min-height:220px;display:flex;align-items:center;justify-content:center;
    padding:22px;
  }
  .vk-promo__media{background:#fff}
  .vk-promo__img{max-width:100%;max-height:220px;width:auto;height:auto;object-fit:contain;display:block;margin:auto}
  .vk-promo__foot{
    padding:18px 20px 20px;color:#fff;background:var(--green,#1c9350);
    display:flex;flex-direction:column;gap:8px;
  }
  .vk-promo__foot h3{margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);font-weight:700;font-size:clamp(17px,1.8vw,22px);line-height:1.2}
  .vk-promo__discount{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;opacity:.92}
  .vk-promo__btn{
    display:inline-block;align-self:flex-start;margin-top:4px;
    background:#fff;color:var(--green,#1c9350);font-size:12px;font-weight:700;
    letter-spacing:.04em;text-transform:uppercase;padding:9px 16px;border-radius:999px;
  }

  @media(max-width:900px){
    .vk-promo__grid{
      grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:78%;
      gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;
      -webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px;
    }
    .vk-promo__grid::-webkit-scrollbar{display:none}
    .vk-promo__tile{scroll-snap-align:start}
    .vk-promo__media{min-height:200px}
  }
</style>

{% schema %}{"name":"Promo tiles","blocks":[{"type":"tile","name":"Tile","settings":[{"type":"product","id":"product","label":"Product (uses its real photo)"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"heading","label":"Heading","default":"Unleash your inner beauty"},{"type":"text","id":"discount","label":"Discount line","default":"UP TO 50% OFF"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Promo tiles","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]}{% endschema %}
