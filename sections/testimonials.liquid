{%- comment -%}
  Testimonials — card carousel with a title, review text, a star rating,
  and the reviewer's avatar, name and role.
{%- endcomment -%}
<section class="section testimonials-section">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="carousel-wrap">
      <button class="carousel-btn" data-dir="prev" type="button" aria-label="Previous reviews">&#8249;</button>
      <div class="carousel testimonial-track" data-carousel>
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <blockquote class="tcard" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3 class="tcard__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="tcard__quote">{{ block.settings.quote }}</p>
            <div class="tcard__stars" aria-label="{{ rating }} out of 5 stars">
              {%- for i in (1..5) -%}<span class="{% if i <= rating %}on{% endif %}">&#9733;</span>{%- endfor -%}
            </div>
            <div class="tcard__person">
              {%- if block.settings.avatar != blank -%}
                <img class="tcard__avatar" src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.author | escape }}" width="56" height="56" loading="lazy">
              {%- else -%}
                <span class="tcard__avatar tcard__avatar--ph">{{ block.settings.author | slice: 0 | upcase }}</span>
              {%- endif -%}
              <div>
                <strong class="tcard__author">{{ block.settings.author }}</strong>
                {%- if block.settings.role != blank -%}<span class="tcard__role">{{ block.settings.role }}</span>{%- endif -%}
              </div>
            </div>
          </blockquote>
        {%- endfor -%}
      </div>
      <button class="carousel-btn" data-dir="next" type="button" aria-label="Next reviews">&#8250;</button>
    </div>
  </div>
</section>

<style>
  .testimonials-section{background:var(--cream)}
  .testimonial-track{grid-auto-columns:calc((100% - 24px)/2);gap:24px}
  .tcard{
    scroll-snap-align:start;
    background:#fff;border-radius:14px;padding:34px 34px 30px;margin:0;
    box-shadow:0 12px 30px rgba(15,48,45,.06);
  }
  .tcard__title{font-family:'Marcellus',Georgia,serif;font-weight:400;font-size:22px;margin:0 0 12px}
  .tcard__quote{color:var(--muted);font-size:15px;line-height:1.65;margin:0 0 18px}
  .tcard__stars{font-size:16px;letter-spacing:2px;margin-bottom:22px;color:#d8d2c8}
  .tcard__stars .on{color:#e8a92b}
  .tcard__person{display:flex;align-items:center;gap:14px}
  .tcard__avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;flex:0 0 56px}
  .tcard__avatar--ph{display:flex;align-items:center;justify-content:center;background:var(--green);color:#fff;font-family:'Marcellus',Georgia,serif;font-size:20px}
  .tcard__author{display:block;font-size:15px}
  .tcard__role{display:block;font-size:13px;color:var(--muted)}
  @media(max-width:900px){.testimonial-track{grid-auto-columns:calc((100% - 14px)/1.15)}}
  @media(max-width:560px){.tcard{padding:26px 24px}}
</style>
<script>
(function(){
  var sec=document.currentScript.previousElementSibling.previousElementSibling;
  if(!sec) return;
  var wrap=sec.querySelector('.carousel-wrap');
  var track=wrap && wrap.querySelector('[data-carousel]');
  if(!track) return;
  var btns=Array.prototype.slice.call(wrap.querySelectorAll('.carousel-btn'));
  function step(){var c=track.firstElementChild;return c?c.getBoundingClientRect().width+24:340}
  function sync(){var max=track.scrollWidth-track.clientWidth-2;btns.forEach(function(b){b.disabled=b.dataset.dir==='prev'?track.scrollLeft<=2:track.scrollLeft>=max})}
  btns.forEach(function(b){b.addEventListener('click',function(){track.scrollBy({left:(b.dataset.dir==='next'?1:-1)*step(),behavior:'smooth'})})});
  track.addEventListener('scroll',sync,{passive:true});window.addEventListener('resize',sync);sync();
})();
</script>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonial" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Exceptional Quality" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Beautiful design, easy to use and a great addition to my routine. I would recommend it to anyone." },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image" },
        { "type": "text", "id": "author", "label": "Author", "default": "Author" },
        { "type": "text", "id": "role", "label": "Role", "default": "Verified customer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [ { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" } ]
    }
  ]
}
{% endschema %}
