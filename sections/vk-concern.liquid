{%- comment -%}
  Velkrova "Shop by concern" strip.
  Photo-led cards: the customer searches by problem, not by category,
  so each card leads with a real photo, the concern and a plain-language
  line under it.
{%- endcomment -%}

<section class="vk-concern">
  <div class="page-width">
    <div class="vk-concern__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vk-concern__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="vk-concern__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="vk-concern__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="vk-concern__grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- assign img = block.settings.image | default: p.featured_image | default: col.featured_image -%}
        <a class="vk-concern__card" href="{% if col != blank %}{{ col.url }}{% else %}{{ block.settings.link | default: '/collections/all' }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="vk-concern__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.label, width: 250, height: 250 }}
            {%- endif -%}
          </div>
          <div class="vk-concern__body">
            <span class="vk-concern__label">{{ block.settings.label | default: col.title }}</span>
            {%- if block.settings.text != blank -%}<span class="vk-concern__text">{{ block.settings.text }}</span>{%- endif -%}
            <span class="vk-concern__go" aria-hidden="true">
              Shop now
              <svg viewBox="0 0 20 20"><path d="M4 10h11M10.5 5.5L15 10l-4.5 4.5"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .vk-concern{padding:clamp(38px,4.6vw,64px) 0;background:#fff}
  .vk-concern__head{max-width:660px;margin:0 auto clamp(24px,3vw,36px);text-align:center}
  .vk-concern__eyebrow{display:inline-block;margin-bottom:11px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#7d7a74);font-weight:500}
  .vk-concern__title{margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);font-weight:700;font-size:clamp(24px,2.6vw,32px);line-height:1.1;letter-spacing:-.015em}
  .vk-concern__sub{margin:13px auto 0;max-width:52ch;font-size:15px;line-height:1.6;color:var(--muted,#7d7a74)}

  .vk-concern__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .vk-concern__card{
    display:flex;flex-direction:column;border-radius:16px;overflow:hidden;
    text-decoration:none;color:inherit;background:#fff;
    border:1px solid var(--line,#e8e3dc);
    box-shadow:0 4px 16px rgba(0,0,0,.04);
    transition:transform .18s ease,box-shadow .18s ease;
  }
  .vk-concern__card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.09)}
  .vk-concern__media{width:100%;aspect-ratio:1/1;background:var(--cream,#f7ede0);overflow:hidden}
  .vk-concern__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}
  .vk-concern__card:hover .vk-concern__media img{transform:scale(1.04)}
  .vk-concern__body{display:flex;flex-direction:column;gap:5px;padding:16px 16px 18px}
  .vk-concern__label{font-size:15px;font-weight:600;line-height:1.3}
  .vk-concern__text{font-size:13px;line-height:1.45;color:var(--muted,#7d7a74)}
  .vk-concern__go{
    display:inline-flex;align-items:center;gap:5px;margin-top:8px;
    font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:var(--green,#1c9350);
  }
  .vk-concern__go svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .18s ease}
  .vk-concern__card:hover .vk-concern__go svg{transform:translateX(3px)}

  @media(max-width:900px){.vk-concern__grid{grid-template-columns:repeat(2,1fr);gap:14px}}
  @media(max-width:560px){
    .vk-concern__head{text-align:left}
    .vk-concern__label{font-size:14px}
    .vk-concern__text{font-size:12px}
  }
</style>

{% schema %}{"name":"Shop by concern","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT ARE YOU WORKING ON?"},{"type":"text","id":"heading","label":"Heading","default":"Shop by concern"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Start with the thing that bothers you, not the shelf it sits on."}],"blocks":[{"type":"concern","name":"Concern","settings":[{"type":"text","id":"label","label":"Label","default":"Fine lines & firmness"},{"type":"textarea","id":"text","label":"Description","default":"Skin that has lost its bounce"},{"type":"collection","id":"collection","label":"Collection"},{"type":"product","id":"product","label":"Product (image fallback)"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Shop by concern","blocks":[{"type":"concern"},{"type":"concern"},{"type":"concern"},{"type":"concern"}]}]}{% endschema %}
