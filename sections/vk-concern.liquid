{%- comment -%}
  Velkrova "Shop by concern".
  Image priority per card: uploaded image > image URL > collection image >
  first product image. Desktop: 4-column grid. Mobile: swipe row.
{%- endcomment -%}
<section class="vk-concern">
  <div class="page-width">
    <div class="vk-concern__head">
      {%- if section.settings.eyebrow != blank -%}<span class="vk-concern__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vk-concern__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="vk-concern__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="vk-concern__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          if col == blank and block.settings.handle != blank
            assign col = collections[block.settings.handle]
          endif
          assign url = block.settings.link
          if url == blank and col != blank
            assign url = col.url
          endif
          assign label = block.settings.label | default: col.title
          assign pic = block.settings.image
          if pic == blank and block.settings.image_url == blank and col != blank
            assign pic = col.image
            if pic == blank
              assign pic = col.products.first.featured_image
            endif
          endif
        -%}
        <a class="vk-concern__card" href="{{ url | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <span class="vk-concern__media">
            {%- if pic != blank -%}
              <img src="{{ pic | image_url: width: 600 }}" srcset="{{ pic | image_url: width: 360 }} 360w, {{ pic | image_url: width: 600 }} 600w" sizes="(max-width:900px) 62vw, 23vw" alt="{{ pic.alt | default: label | escape }}" loading="lazy" width="600" height="600">
            {%- elsif block.settings.image_url != blank -%}
              {%- assign base = block.settings.image_url | split: '?' | first -%}
              <img src="{{ base }}?width=600" srcset="{{ base }}?width=360 360w, {{ base }}?width=600 600w" sizes="(max-width:900px) 62vw, 23vw" alt="{{ label | escape }}" loading="lazy" width="600" height="600">
            {%- endif -%}
          </span>
          <span class="vk-concern__body">
            <span class="vk-concern__label">{{ label }}</span>
            {%- if block.settings.text != blank -%}<span class="vk-concern__text">{{ block.settings.text }}</span>{%- endif -%}
          </span>
          <span class="vk-concern__go" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h11M10.5 5.5L15 10l-4.5 4.5"/></svg></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .vk-concern{padding:clamp(40px,5vw,72px) 0;background:#fff}
  .vk-concern__head{max-width:660px;margin:0 auto clamp(24px,3vw,36px);text-align:center}
  .vk-concern__eyebrow{display:inline-block;margin-bottom:11px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:500}
  .vk-concern__title{margin:0;font-family:var(--font-heading);font-weight:400;font-size:clamp(26px,3vw,38px);line-height:1.1;letter-spacing:-.015em}
  .vk-concern__sub{margin:13px auto 0;max-width:52ch;font-size:15px;line-height:1.6;color:var(--muted)}
  .vk-concern__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .vk-concern__card{position:relative;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff;color:inherit;transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease}
  .vk-concern__card:hover{border-color:var(--green);transform:translateY(-3px);box-shadow:0 14px 30px rgba(15,48,45,.08)}
  .vk-concern__media{position:relative;display:block;aspect-ratio:4/3;background:var(--cream);overflow:hidden}
  .vk-concern__media img{position:absolute;inset:0;width:100%!important;height:100%!important;max-width:none;object-fit:cover;transition:transform .5s ease}
  .vk-concern__card:hover .vk-concern__media img{transform:scale(1.04)}
  .vk-concern__body{display:flex;flex-direction:column;gap:5px;padding:16px 44px 18px 18px}
  .vk-concern__label{font-size:15px;font-weight:600;line-height:1.3}
  .vk-concern__text{font-size:13px;line-height:1.45;color:var(--muted)}
  .vk-concern__go{position:absolute;right:16px;bottom:20px}
  .vk-concern__go svg{width:17px;height:17px;fill:none;stroke:var(--green);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform .18s ease}
  .vk-concern__card:hover .vk-concern__go svg{transform:translateX(3px)}
  @media(max-width:900px){
    .vk-concern__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;gap:12px;margin-inline:-20px;padding:0 20px 6px}
    .vk-concern__grid::-webkit-scrollbar{display:none}
    .vk-concern__card{flex:0 0 62%;scroll-snap-align:start}
    .vk-concern__card:hover{transform:none}
  }
  @media(max-width:560px){.vk-concern__grid{margin-inline:-12px;padding:0 12px 6px}.vk-concern__card{flex-basis:70%}.vk-concern__label{font-size:14px}}
</style>
{% schema %}{"name":"Shop by concern","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT ARE YOU WORKING ON?"},{"type":"text","id":"heading","label":"Heading","default":"Shop by concern"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Start with the thing that bothers you, not the shelf it sits on."}],"blocks":[{"type":"concern","name":"Concern","settings":[{"type":"text","id":"label","label":"Label","default":"Fine lines & firmness"},{"type":"textarea","id":"text","label":"Description","default":"Skin that has lost its bounce"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"handle","label":"Collection handle (fallback)"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_url","label":"Image URL (fallback)"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Shop by concern","blocks":[{"type":"concern"},{"type":"concern"},{"type":"concern"},{"type":"concern"}]}]}{% endschema %}
