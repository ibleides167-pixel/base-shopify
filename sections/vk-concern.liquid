{%- comment -%}
  Velkrova "Shop by concern" strip.
  Text-led cards with a small real-product thumbnail: the customer
  searches by problem, not by category, so each card leads with the
  concern and a plain-language line under it, backed by the actual
  product that solves it.
{%- endcomment -%}

<section class="vk-concern">
  <div class="page-width">
    <div class="vk-concern__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vk-concern__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="vk-concern__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="vk-concern__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="vk-concern__grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- assign thumb = p.featured_image | default: col.featured_image -%}
        <a class="vk-concern__card" href="{% if col != blank %}{{ col.url }}{% else %}{{ block.settings.link | default: '/collections/all' }}{% endif %}" {{ block.shopify_attributes }}>
          {%- if thumb != blank -%}
            <span class="vk-concern__thumb">{{ thumb | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.label, width: 80, height: 80 }}</span>
          {%- endif -%}
          <span class="vk-concern__body">
            <span class="vk-concern__label">{{ block.settings.label | default: col.title }}</span>
            {%- if block.settings.text != blank -%}<span class="vk-concern__text">{{ block.settings.text }}</span>{%- endif -%}
          </span>
          <span class="vk-concern__go" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M4 10h11M10.5 5.5L15 10l-4.5 4.5"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .vk-concern{padding:clamp(38px,4.6vw,64px) 0;background:#fff}
  .vk-concern__head{max-width:660px;margin:0 auto clamp(24px,3vw,36px);text-align:center}
  .vk-concern__eyebrow{display:inline-block;margin-bottom:11px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#7d7a74);font-weight:500}
  .vk-concern__title{margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);font-weight:700;font-size:clamp(24px,2.6vw,32px);line-height:1.1;letter-spacing:-.015em}
  .vk-concern__sub{margin:13px auto 0;max-width:52ch;font-size:15px;line-height:1.6;color:var(--muted,#7d7a74)}

  .vk-concern__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .vk-concern__card{
    position:relative;display:flex;align-items:center;gap:12px;
    padding:16px 40px 16px 16px;
    border:1px solid var(--line,#e8e3dc);border-radius:14px;
    text-decoration:none;color:inherit;background:#fff;
    transition:border-color .18s ease,background .18s ease,transform .18s ease;
  }
  .vk-concern__card:hover{border-color:var(--green,#073f3a);background:#f6faf9;transform:translateY(-2px)}
  .vk-concern__thumb{flex:none;width:52px;height:52px;border-radius:10px;overflow:hidden;background:var(--cream,#f7ede0)}
  .vk-concern__thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .vk-concern__body{display:flex;flex-direction:column;gap:5px;min-width:0}
  .vk-concern__label{font-size:15px;font-weight:600;line-height:1.3}
  .vk-concern__text{font-size:13px;line-height:1.45;color:var(--muted,#7d7a74)}
  .vk-concern__go{position:absolute;top:50%;right:14px;transform:translateY(-50%)}
  .vk-concern__go svg{width:17px;height:17px;fill:none;stroke:var(--green,#073f3a);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform .18s ease}
  .vk-concern__card:hover .vk-concern__go svg{transform:translateX(3px)}

  @media(max-width:900px){.vk-concern__grid{grid-template-columns:repeat(2,1fr);gap:12px}}
  @media(max-width:560px){
    .vk-concern__head{text-align:left}
    .vk-concern__card{padding:12px 34px 12px 12px;border-radius:12px}
    .vk-concern__thumb{width:44px;height:44px}
    .vk-concern__label{font-size:14px}
    .vk-concern__text{font-size:12px}
  }
</style>

{% schema %}{"name":"Shop by concern","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT ARE YOU WORKING ON?"},{"type":"text","id":"heading","label":"Heading","default":"Shop by concern"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Start with the thing that bothers you, not the shelf it sits on."}],"blocks":[{"type":"concern","name":"Concern","settings":[{"type":"text","id":"label","label":"Label","default":"Fine lines & firmness"},{"type":"textarea","id":"text","label":"Description","default":"Skin that has lost its bounce"},{"type":"collection","id":"collection","label":"Collection"},{"type":"product","id":"product","label":"Product (thumbnail)"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Shop by concern","blocks":[{"type":"concern"},{"type":"concern"},{"type":"concern"},{"type":"concern"}]}]}{% endschema %}
