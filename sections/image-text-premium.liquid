<section class="section vk-it"><div class="page-width"><div class="image-text">
  <div class="image-text-content">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="vk-it__text">{{ section.settings.text }}</div>
    {%- if section.settings.label != blank -%}<a class="btn secondary" href="{{ section.settings.link | default: '/pages/about' }}">{{ section.settings.label }}</a>{%- endif -%}
  </div>
  <a class="image-text-media" href="{{ section.settings.link | default: '/pages/about' }}" tabindex="-1" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w" sizes="(max-width:900px) 100vw, 50vw" alt="{{ section.settings.alt | escape }}" loading="lazy">
    {%- elsif section.settings.image_url != blank -%}
      <img src="{{ section.settings.image_url }}" alt="{{ section.settings.alt | escape }}" loading="lazy">
    {%- else -%}
      <div class="placeholder">Lifestyle image</div>
    {%- endif -%}
  </a>
</div></div></section>
<style>
  .vk-it .image-text{border-radius:16px;overflow:hidden}
  .vk-it .image-text-media{position:relative;display:block;min-height:520px;overflow:hidden}
  .vk-it .image-text-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
  .vk-it .image-text-media:hover img{transform:scale(1.03)}
  .vk-it__text{margin:0 0 26px;color:#3d4b48;line-height:1.7}
  .vk-it .btn{align-self:flex-start;border-radius:999px}
  @media(max-width:900px){.vk-it .image-text-media{order:-1;min-height:0;aspect-ratio:16/10}.vk-it .image-text-content{padding:30px 24px}}
</style>
{% schema %}{"name":"Image with text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY CHOOSE US"},{"type":"text","id":"heading","label":"Heading","default":"Advanced technology. Real routines."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtfully selected products that combine innovation, comfort and premium design.</p>"},{"type":"text","id":"label","label":"Button label","default":"Discover our story"},{"type":"url","id":"link","label":"Button link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_url","label":"Image URL (fallback)"},{"type":"text","id":"alt","label":"Image description"}],"presets":[{"name":"Image with text"}]}{% endschema %}
