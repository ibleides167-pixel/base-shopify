<section class="section"><div class="page-width"><div class="image-text"><div class="image-text-content"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="section-title">{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div><a class="btn secondary" href="{{ section.settings.link }}">{{ section.settings.label }}</a></div><div class="image-text-media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}<div class="placeholder">Lifestyle image</div>{% endif %}</div></div></div></section>{% schema %}{"name":"Image with text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY CHOOSE US"},{"type":"text","id":"heading","label":"Heading","default":"Advanced technology. Real results."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtfully selected products that combine innovation, comfort and premium design.</p>"},{"type":"text","id":"label","label":"Button label","default":"Discover our story"},{"type":"url","id":"link","label":"Button link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"Image with text"}]}{% endschema %}
