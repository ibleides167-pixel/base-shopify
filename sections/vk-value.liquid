{%- comment -%}
  Velkrova value comparison: what the salon charges per visit versus a
  device you own. Figures are editable per block so they can be kept
  accurate and honest.
{%- endcomment -%}

<section class="vk-value">
  <div class="page-width">
    <div class="vk-value__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vk-value__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="vk-value__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="vk-value__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="vk-value__grid">
      {%- for block in section.blocks -%}
        {%- assign p = all_products[block.settings.product] -%}
        <article class="vk-value__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="vk-value__media">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.treatment, width: 300, height: 300 }}</div>
          {%- elsif p.featured_image != blank -%}
            <div class="vk-value__media">{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, width: 300, height: 300 }}</div>
          {%- endif -%}
          <div class="vk-value__content">
          <h3 class="vk-value__what">{{ block.settings.treatment }}</h3>

          <div class="vk-value__rows">
            <div class="vk-value__row vk-value__row--salon">
              <span>{{ block.settings.salon_label }}</span>
              <strong>{{ block.settings.salon_price }}</strong>
            </div>
            <div class="vk-value__row vk-value__row--ours">
              <span>{{ block.settings.ours_label }}</span>
              <strong>{% if p != blank %}{{ p.price | money }}{% else %}{{ block.settings.ours_price }}{% endif %}</strong>
            </div>
          </div>

          <p class="vk-value__note">{{ block.settings.note }}</p>

          {%- if p != blank -%}
            <a class="vk-value__link" href="{{ p.url }}">{{ block.settings.cta | default: 'Shop it' }} &rsaquo;</a>
          {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="vk-value__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .vk-value{padding:clamp(40px,5vw,72px) 0;background:#fff}
  .vk-value__head{max-width:680px;margin:0 auto clamp(26px,3vw,38px);text-align:center}
  .vk-value__eyebrow{
    display:inline-block;margin-bottom:12px;font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--muted,#7d7a74);font-weight:500;
  }
  .vk-value__title{
    margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);font-weight:700;
    font-size:clamp(24px,2.6vw,32px);line-height:1.1;letter-spacing:-.015em;
  }
  .vk-value__sub{margin:14px auto 0;max-width:56ch;font-size:15px;line-height:1.6;color:var(--muted,#7d7a74)}

  .vk-value__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vk-value__card{scroll-snap-align:start}
  .vk-value__card{
    border:1px solid var(--line,#e8e3dc);border-radius:14px;overflow:hidden;
    display:flex;flex-direction:column;
    box-shadow:0 4px 18px rgba(0,0,0,.04);
    transition:transform .18s ease,box-shadow .18s ease;
  }
  .vk-value__card:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,0,0,.08)}
  .vk-value__content{padding:20px 22px 24px;display:flex;flex-direction:column;gap:14px}
  .vk-value__media{
    width:100%;aspect-ratio:4/3;overflow:hidden;background:var(--cream,#f7ede0);
  }
  .vk-value__media img{width:100%;height:100%;object-fit:cover;display:block}
  .vk-value__what{
    margin:0;font-family:var(--font-heading,'Poppins',Arial,sans-serif);
    font-size:16px;font-weight:600;line-height:1.3;
  }
  .vk-value__rows{display:grid;gap:8px}
  .vk-value__row{
    display:flex;align-items:baseline;justify-content:space-between;gap:12px;
    padding:11px 13px;border-radius:2px;font-size:13px;
  }
  .vk-value__row--salon{background:#f7f5f2;color:var(--muted,#7d7a74)}
  .vk-value__row--salon strong{font-size:16px;font-weight:600;text-decoration:line-through;opacity:.75}
  .vk-value__row--ours{background:var(--green,#1c9350);color:#fff}
  .vk-value__row--ours strong{font-size:18px;font-weight:600}
  .vk-value__note{margin:0;font-size:13px;line-height:1.5;color:var(--muted,#7d7a74)}
  .vk-value__link{
    margin-top:auto;padding-top:4px;font-size:12px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--green,#073f3a);text-decoration:none;
  }
  .vk-value__link:hover{text-decoration:underline}
  .vk-value__disclaimer{
    margin:22px auto 0;max-width:70ch;text-align:center;
    font-size:12px;line-height:1.5;color:var(--muted,#7d7a74);
  }

  @media(max-width:900px){
    .vk-value__grid{
      grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:78%;
      gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;
      -webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px;
    }
    .vk-value__grid::-webkit-scrollbar{display:none}
    .vk-value__content{padding:18px}
  }
</style>

{% schema %}{"name":"Salon comparison","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT IT REPLACES"},{"type":"text","id":"heading","label":"Heading","default":"Own it once, or pay every visit"},{"type":"textarea","id":"subheading","label":"Subheading","default":"The device is not the expensive part. The appointments are."},{"type":"textarea","id":"disclaimer","label":"Disclaimer","default":"Salon prices are typical UK ranges and vary by area and provider."}],"blocks":[{"type":"item","name":"Comparison","settings":[{"type":"text","id":"treatment","label":"Treatment","default":"A deep-tissue back massage"},{"type":"text","id":"salon_label","label":"Salon label","default":"Typical UK salon, per visit"},{"type":"text","id":"salon_price","label":"Salon price","default":"£50-70"},{"type":"text","id":"ours_label","label":"Our label","default":"Yours to keep"},{"type":"text","id":"ours_price","label":"Fallback price","default":"£64.99"},{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"textarea","id":"note","label":"Note","default":"Pays for itself after roughly one appointment, then costs nothing."},{"type":"text","id":"cta","label":"Link label","default":"Shop it"}]}],"presets":[{"name":"Salon comparison","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}{% endschema %}
