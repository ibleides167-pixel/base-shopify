{%- assign p = section.settings.product -%}
<section class="offer"><div class="page-width"><div class="offer-grid">
  <div class="offer-copy">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if p != blank -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      <div class="offer-price">
        <span class="now">{{ v.price | money }}</span>
        {%- if v.compare_at_price > v.price -%}
          <span class="was">{{ v.compare_at_price | money }}</span>
          {%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
          <span class="offer-save">Save {{ pct }}%</span>
        {%- endif -%}
      </div>
      <a class="btn" href="{{ p.url }}">{{ section.settings.button_label }}</a>
    {%- else -%}
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <a class="offer-media" href="{% if p != blank %}{{ p.url }}{% else %}{{ section.settings.button_link }}{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- assign offer_img_h = 900 | divided_by: section.settings.image.aspect_ratio | round -%}
      <img src="{{ section.settings.image | image_url: width: 900 }}" srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w" sizes="(max-width: 900px) 90vw, 42vw" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="{{ offer_img_h }}">
    {%- elsif p.featured_image != blank -%}
      {%- assign offer_pimg_h = 900 | divided_by: p.featured_image.aspect_ratio | round -%}
      <img src="{{ p.featured_image | image_url: width: 900 }}" srcset="{{ p.featured_image | image_url: width: 500 }} 500w, {{ p.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 900px) 90vw, 42vw" alt="{{ p.title | escape }}" loading="lazy" width="900" height="{{ offer_pimg_h }}">
    {%- else -%}
      <div class="placeholder">Offer image</div>
    {%- endif -%}
  </a>
</div></div></section>

<style>
  .offer{padding-block:clamp(34px,4.4vw,72px)}
  .offer-media{
    display:block;width:100%;aspect-ratio:5/4;
    overflow:hidden;border-radius:12px;background:#fff;line-height:0;
  }
  .offer-media img{
    width:100%;height:100%;object-fit:cover;object-position:center;
    display:block;border-radius:12px;transition:transform .4s ease;
  }
  .offer-media:hover img{transform:scale(1.03)}
  .offer-media .placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f7f5f2;font-size:13px}
  .offer-save{display:inline-block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.16);color:#fff;padding:5px 10px;border-radius:999px}

  @media(max-width:900px){
    /* No fixed frame on mobile: the container hugs the image, so nothing
       is cropped and there is no letterboxing at any screen width. */
    .offer{padding-block:30px}
    .offer-grid{gap:20px}
    .offer-media{aspect-ratio:auto;max-height:none;border-radius:10px;line-height:0}
    .offer-media img{height:auto;object-fit:contain;border-radius:10px}
    .offer-copy h2{margin-bottom:10px}
    .offer-copy p{margin-bottom:16px;font-size:15px}
    .offer-price{margin-bottom:18px}
    .offer-price .now{font-size:28px}
  }
</style>
{% schema %}{"name":"Offer banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUNDLE OFFER"},{"type":"text","id":"heading","label":"Heading","default":"The Glow Duo"},{"type":"textarea","id":"text","label":"Text"},{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the duo"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Offer banner"}]}{% endschema %}
