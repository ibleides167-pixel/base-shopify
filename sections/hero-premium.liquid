<div class="hero-slider" data-hero>
  <div class="hero-slides" data-hero-track>
    {%- for block in section.blocks -%}
      {%- assign has_copy = false -%}
      {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank or block.settings.eyebrow != blank -%}{%- assign has_copy = true -%}{%- endif -%}
      <div class="hero-slide" {{ block.shopify_attributes }}>
        <div class="hero-media-wrap">
          {%- unless has_copy -%}{%- if block.settings.button_link != blank -%}<a href="{{ block.settings.button_link }}" class="hero-link" aria-label="{{ block.settings.link_label | default: 'Shop now' }}">{%- endif -%}{%- endunless -%}
          <picture>
            {%- if block.settings.image_mobile != blank -%}<source media="(max-width:760px)" srcset="{{ block.settings.image_mobile | image_url: width: 1100 }}">
            {%- elsif block.settings.image_url_mobile != blank -%}<source media="(max-width:760px)" srcset="{{ block.settings.image_url_mobile }}">{%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.alt | default: shop.name | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.alt | default: shop.name | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- endif -%}
          </picture>
          {%- unless has_copy -%}{%- if block.settings.button_link != blank -%}</a>{%- endif -%}{%- endunless -%}
          {%- if has_copy -%}
            <div class="hero-overlay">
              <div class="page-width">
                <div class="hero-copy">
                  {%- if block.settings.eyebrow != blank -%}<div class="eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
                  {%- if block.settings.button_label != blank -%}<a class="btn" href="{{ block.settings.button_link | default: '/collections/best-sellers-1' }}">{{ block.settings.button_label }}</a>{%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="hero-dots">
      {%- for block in section.blocks -%}<button class="hero-dot" type="button" data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Slide {{ forloop.index }}"></button>{%- endfor -%}
    </div>
  {%- endif -%}
</div>
<script>
(function(){
  var root=document.currentScript.previousElementSibling;
  if(!root) return;
  var track=root.querySelector('[data-hero-track]');
  var dots=Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));
  var total=track?track.children.length:0;
  if(total<2) return;
  var i=0,timer=null;
  function go(n){i=(n+total)%total;track.style.transform='translateX(-'+(i*100)+'%)';dots.forEach(function(d,x){d.setAttribute('aria-current',x===i?'true':'false')})}
  function play(){stop();timer=setInterval(function(){go(i+1)},6000)}
  function stop(){if(timer){clearInterval(timer);timer=null}}
  dots.forEach(function(d){d.addEventListener('click',function(){stop();go(+d.dataset.index);play()})});
  root.addEventListener('mouseenter',stop);
  root.addEventListener('mouseleave',play);
  var x0=null;
  root.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;stop()},{passive:true});
  root.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;if(Math.abs(dx)>45)go(dx<0?i+1:i-1);x0=null;play()},{passive:true});
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches) play();
})();
</script>
{% schema %}{"name":"Hero slideshow","max_blocks":5,"settings":[],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"paragraph","content":"Leave the text fields empty if your image already has text baked into it. The whole slide becomes clickable instead."},{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"image_mobile","label":"Mobile image"},{"type":"text","id":"image_url","label":"Desktop image URL (fallback)"},{"type":"text","id":"image_url_mobile","label":"Mobile image URL (fallback)"},{"type":"text","id":"alt","label":"Image description (accessibility)"},{"type":"url","id":"button_link","label":"Link"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"Button label"}]}],"presets":[{"name":"Hero slideshow","blocks":[{"type":"slide"}]}]}{% endschema %}
