{%- comment -%}
  Velkrova "Seven light modes" — for the LED mask PDP.

  Deliberately cautious: cosmetic, appearance-led language only. No
  wavelengths, no clinical or medical claims, no treatment promises.
  Red / blue / green wording mirrors the merchant's own product FAQ.
  Every colour and line is editable in the theme editor so it can be
  kept accurate.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<section class="vk-modes">
  <div class="page-width">
    <div class="vk-modes__head">
      {%- if section.settings.eyebrow != blank -%}<span class="vk-modes__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vk-modes__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="vk-modes__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="vk-modes__grid">
      {%- for block in section.blocks -%}
        <div class="vk-modes__card" {{ block.shopify_attributes }}>
          <span class="vk-modes__swatch" style="--c:{{ block.settings.hex | default: '#cccccc' }}"></span>
          <span class="vk-modes__name">{{ block.settings.name }}</span>
          {%- if block.settings.focus != blank -%}<span class="vk-modes__focus">{{ block.settings.focus }}</span>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="vk-modes__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}<p class="vk-modes__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
  .vk-modes{padding:clamp(40px,5vw,72px) 0;background:#fff;border-top:1px solid var(--line,#e8e3dc)}
  .vk-modes__head{max-width:640px;margin:0 auto clamp(26px,3vw,38px);text-align:center}
  .vk-modes__eyebrow{display:inline-block;margin-bottom:11px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#64706d);font-weight:500}
  .vk-modes__title{margin:0;font-family:var(--font-heading,'Marcellus',Georgia,serif);font-weight:400;font-size:clamp(24px,2.8vw,36px);line-height:1.1;letter-spacing:-.015em}
  .vk-modes__sub{margin:13px auto 0;max-width:52ch;font-size:15px;line-height:1.6;color:var(--muted,#64706d)}
  .vk-modes__grid{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
  .vk-modes__card{flex:1 1 200px;max-width:250px;display:flex;flex-direction:column;gap:8px;padding:22px 20px;border:1px solid var(--line,#e8e3dc);border-radius:14px;background:#fff;transition:border-color .18s ease,transform .18s ease}
  .vk-modes__card:hover{border-color:var(--green,#073f3a);transform:translateY(-2px)}
  .vk-modes__swatch{width:40px;height:40px;border-radius:50%;background:var(--c);border:1px solid rgba(0,0,0,.06);box-shadow:0 8px 18px -6px var(--c)}
  .vk-modes__name{font-size:15px;font-weight:600;line-height:1.3}
  .vk-modes__focus{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--green,#073f3a);font-weight:600}
  .vk-modes__text{margin:0;font-size:13px;line-height:1.5;color:var(--muted,#64706d)}
  .vk-modes__note{margin:clamp(24px,3vw,34px) auto 0;max-width:70ch;text-align:center;font-size:12px;line-height:1.55;color:var(--muted,#64706d)}
  @media(max-width:560px){
    .vk-modes__head{text-align:left}
    .vk-modes__card{flex:1 1 100%;max-width:none;flex-direction:row;align-items:flex-start;gap:14px;flex-wrap:wrap;padding:16px}
    .vk-modes__swatch{flex:none}
    .vk-modes__name,.vk-modes__focus{width:calc(100% - 54px)}
    .vk-modes__text{flex:1 1 100%}
  }
</style>

{% schema %}
{
  "name": "LED light modes",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SEVEN LIGHT MODES"},
    {"type":"text","id":"heading","label":"Heading","default":"One mask. Seven light modes."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Switch colour depending on what your skin needs that week."},
    {"type":"textarea","id":"note","label":"Note / disclaimer","default":"These are cosmetic light settings, not medical treatments. Follow the supplied manual for session length and frequency, and read the safety notes before your first use."}
  ],
  "blocks": [
    {"type":"mode","name":"Light mode","settings":[
      {"type":"color","id":"hex","label":"Colour","default":"#cccccc"},
      {"type":"text","id":"name","label":"Name","default":"Red light"},
      {"type":"text","id":"focus","label":"Focus (short)","default":"Firmness & fine lines"},
      {"type":"textarea","id":"text","label":"Description"}
    ]}
  ],
  "max_blocks": 8,
  "presets": [{"name":"LED light modes"}]
}
{% endschema %}
