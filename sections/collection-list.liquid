{%- comment -%}
  ============================================================
  COLLECTION LIST — carrossel de coleções selecionadas
  ============================================================

  O QUE FAZ:
  Mostra um conjunto de coleções ESCOLHIDAS pelo lojista (via blocks)
  em um carrossel horizontal, cada card com a imagem da coleção e um
  botão em pílula sobreposto (embaixo da imagem) com o nome — em vez
  de legenda separada abaixo. Diferente do main-list-collections,
  aqui você curadoria quais coleções aparecem e em que ordem.

  ONDE É USADA:
  Seção reutilizável (tem preset com 4 blocos) — comum na home, tipo
  "compre por categoria".

  PRINCIPAIS PARTES:
  - section.blocks do tipo featured_collection (cada um escolhe 1 coleção)
  - featured_image da coleção ou placeholder SVG
  - Setas prev/next: comportamento genérico em assets/carousel.js
    (o mesmo script usado pelo carrossel de featured-collection)
  - Settings: heading, columns_desktop (quantos cabem por vez)

  OBSERVAÇÕES:
  Sem JS, ainda funciona como scroll horizontal nativo (as setas só
  ficam sem ação, nada quebra).
{%- endcomment -%}
<div class="collection-list page-width" data-section-id="{{ section.id }}" style="--grid-columns: {{ section.settings.columns_desktop }};">
  {%- if section.settings.heading != blank -%}
    <div class="section-head"><h2>{{ section.settings.heading | escape }}</h2></div>
  {%- endif -%}

  <div class="collection-list__carousel-wrap" data-carousel-wrap>
    <button class="collection-list__nav" data-dir="prev" type="button" aria-label="Previous collections">{% render 'icon', name: 'chevron' %}</button>
    <ul class="collection-list__grid" role="list" data-carousel>
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: '#' }}" class="collection-card">
            <div class="collection-card__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 720
                  | image_tag:
                    loading: 'lazy',
                    class: 'collection-card__image',
                    widths: '360, 540, 720',
                    sizes: '(min-width: 1000px) 25vw, 50vw',
                    alt: collection.title | escape
                }}
              {%- else -%}
                {%- case forloop.index0 | modulo: 4 -%}
                  {%- when 0 -%}{{ 'velkrova-category-face.jpg' | asset_url | image_tag: loading: 'lazy', class: 'collection-card__image', alt: collection.title | escape }}
                  {%- when 1 -%}{{ 'velkrova-category-hair.jpg' | asset_url | image_tag: loading: 'lazy', class: 'collection-card__image', alt: collection.title | escape }}
                  {%- when 2 -%}{{ 'velkrova-category-body.jpg' | asset_url | image_tag: loading: 'lazy', class: 'collection-card__image', alt: collection.title | escape }}
                  {%- when 3 -%}{{ 'velkrova-category-skin.jpg' | asset_url | image_tag: loading: 'lazy', class: 'collection-card__image', alt: collection.title | escape }}
                {%- endcase -%}
              {%- endif -%}
              <span class="collection-card__pill">{{ collection.title | default: 'onboarding.collection_title' | t }}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <button class="collection-list__nav" data-dir="next" type="button" aria-label="Next collections">{% render 'icon', name: 'chevron' %}</button>
  </div>
</div>

<style>
  .collection-list { padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }

  .collection-list__carousel-wrap { position: relative; display: flex; align-items: center; gap: 8px; }
  .collection-list__grid {
    --gap: 24px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: 4px 0 12px;
    scrollbar-width: none;
  }
  .collection-list__grid::-webkit-scrollbar { display: none; }
  .collection-list__grid > li {
    flex: 0 0 calc((100% - (var(--grid-columns, 4) - 1) * var(--gap)) / var(--grid-columns, 4));
    scroll-snap-align: start;
  }

  .collection-card { display: block; text-decoration: none; color: inherit; }
  .collection-card__media { position: relative; width: 100%; padding-bottom: 100%; overflow: hidden; border-radius: var(--media-radius); background-color: var(--color-background-contrast); }
  .collection-card__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .collection-card:hover .collection-card__image { transform: scale(1.03); }
  .collection-card__pill {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    padding: 10px 22px;
    font-size: var(--f2);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-background);
    border-radius: var(--buttons-radius, 4px);
    white-space: nowrap;
  }

  .collection-list__nav {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .collection-list__nav[data-dir="prev"] svg { transform: rotate(90deg); }
  .collection-list__nav[data-dir="next"] svg { transform: rotate(-90deg); }
  .collection-list__nav:disabled { opacity: 0.3; cursor: default; }

  @media screen and (max-width: 1000px) {
    .collection-list__grid { --gap: 12px; }
    .collection-list__grid > li { flex-basis: calc((100% - var(--gap)) / 2); }
    .collection-list__nav { display: none; }
  }
</style>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "default": "Collections", "label": "t:sections.collection_list.settings.heading.label" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "t:sections.collection_list.settings.columns_desktop.label" }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection_list.blocks.featured_collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.blocks.featured_collection.settings.collection.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
