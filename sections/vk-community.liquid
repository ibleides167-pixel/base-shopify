{%- comment -%}
  Community / lookbook grid — UGC-style images with a handle and a
  "Shop the look" link. Styled in the Velkrova cream/green palette.
{%- endcomment -%}
<section class="vk-community">
  <div class="page-width">
    <div class="vk-community__head">
      {%- if section.settings.eyebrow != blank -%}<span class="vk-community__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="vk-community__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="vk-community__grid">
      {%- for block in section.blocks -%}
        <div class="vk-community__cell" {{ block.shopify_attributes }}>
          <span class="vk-community__user">{{ block.settings.username | default: '@velkrova' }}</span>
          <a class="vk-community__media" href="{{ block.settings.link | default: '/collections/best-sellers' }}" aria-label="{{ block.settings.username | default: 'Shop the look' | escape }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.username }}
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.username | escape }}" loading="lazy">
            {%- else -%}
              <span class="placeholder">Add an image</span>
            {%- endif -%}
          </a>
          <a class="vk-community__cta" href="{{ block.settings.link | default: '/collections/best-sellers' }}">Shop the look</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .vk-community{padding:clamp(40px,5vw,72px) 0;background:var(--cream)}
  .vk-community__head{margin-bottom:clamp(24px,3vw,38px)}
  .vk-community__eyebrow{display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
  .vk-community__title{margin:0;font-family:'Marcellus',Georgia,serif;font-weight:400;font-size:clamp(28px,4vw,46px);line-height:1.05;letter-spacing:-.01em}
  .vk-community__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .vk-community__cell{display:flex;flex-direction:column;align-items:center;text-align:center}
  .vk-community__user{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
  .vk-community__media{display:block;width:100%;aspect-ratio:1/1;border-radius:14px;overflow:hidden;background:#fff}
  .vk-community__media img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .vk-community__cell:hover .vk-community__media img{transform:scale(1.05)}
  .vk-community__media .placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:13px;color:var(--muted)}
  .vk-community__cta{margin-top:16px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--green);border-bottom:1px solid var(--green);padding-bottom:3px}
  .vk-community__cta:hover{opacity:.7}
  @media(max-width:900px){
    .vk-community__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;gap:14px}
    .vk-community__grid::-webkit-scrollbar{display:none}
    .vk-community__cell{flex:0 0 66%;scroll-snap-align:start}
  }
</style>
{% schema %}
{
  "name": "Community grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TAG @VELKROVA FOR A CHANCE TO BE FEATURED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our community of 100k+" }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "username", "label": "Handle", "default": "@velkrova" },
        { "type": "url", "id": "link", "label": "Shop the look link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Community grid",
      "blocks": [ { "type": "cell" }, { "type": "cell" }, { "type": "cell" }, { "type": "cell" } ]
    }
  ]
}
{% endschema %}
