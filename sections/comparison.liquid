{%- comment -%}
  ============================================================
  COMPARISON — tabela "nós vs. outros"
  ============================================================

  O QUE FAZ:
  Texto de um lado, tabela do outro comparando a loja com "outros"
  em uma lista de linhas configuráveis (cada linha é um bloco).
  A coluna da loja usa check verde, a coluna "outros" usa X cinza.

  ONDE É USADA:
  Seção reutilizável (tem preset com 5 blocos) — comum na home,
  como argumento de confiança antes do FAQ ou do carrinho.

  PRINCIPAIS PARTES:
  - section.blocks do tipo 'row' (cada um só tem um texto)
  - us_label / them_label: cabeçalho das duas colunas
  - heading_accent: parte do título que sai destacada na cor de
    accent (renderizada dentro de <em>, sem itálico — só cor)

  OBSERVAÇÕES:
  Use linhas verificáveis (ex: "frete grátis sem valor mínimo"), não
  alegações vagas de qualidade — comparação com concorrente genérico
  só se sustenta quando é algo que dá pra provar.
{%- endcomment -%}
<section class="comparison">
  <div class="page-width">
    <div class="comparison__grid">
      <div class="comparison__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if section.settings.text != blank -%}<p class="comparison__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="comparison__table-wrap">
        <table class="comparison__table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              <th scope="col" class="is-us">{{ section.settings.us_label | escape }}</th>
              <th scope="col">{{ section.settings.them_label | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td class="is-us">{% render 'icon', name: 'check' %}</td>
                <td>{% render 'icon', name: 'cross' %}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .comparison { padding-block: var(--spacing-sections); }
  .comparison__grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 60px; align-items: center; }
  .comparison__copy h2 { font-size: var(--f7); line-height: 1.1; margin: 0 0 14px; }
  .comparison__copy h2 em { font-style: normal; color: var(--color-accent); }
  .comparison__text { font-size: var(--f2); opacity: 0.7; max-width: 46ch; margin: 0; }

  .comparison__table-wrap { position: relative; padding-block: 18px; }
  .comparison__table-wrap::before {
    content: ''; position: absolute; top: 0; bottom: 0; left: calc(50% + 2px); width: 26%;
    background: var(--color-accent); border-radius: var(--media-radius); z-index: 0;
  }
  .comparison__table { width: 100%; border-collapse: collapse; font-size: var(--f1); position: relative; z-index: 1; }
  .comparison__table th, .comparison__table td { padding: 15px 8px; text-align: center; }
  .comparison__table thead th { font-size: var(--f0); letter-spacing: 0.07em; text-transform: uppercase; font-weight: 600; padding-block: 8px 14px; }
  .comparison__table thead .is-us { color: var(--color-accent-text); }
  .comparison__table tbody th { text-align: left; font-weight: 500; line-height: 1.35; padding-left: 0; width: 48%; }
  .comparison__table tbody tr + tr th,
  .comparison__table tbody tr + tr td:not(.is-us) { border-top: 1px solid var(--color-border); }
  .comparison__table td:not(.is-us) { background: var(--color-background-contrast); }
  .comparison__table tbody tr:first-child td:not(.is-us) { border-radius: var(--media-radius) var(--media-radius) 0 0; }
  .comparison__table tbody tr:last-child td:not(.is-us) { border-radius: 0 0 var(--media-radius) var(--media-radius); }
  .comparison__table svg { vertical-align: middle; }
  .comparison__table .is-us svg { stroke: var(--color-accent-text); }
  .comparison__table td:not(.is-us) svg { stroke: var(--color-background); opacity: 0.7; }

  @media screen and (max-width: 900px) {
    .comparison__grid { grid-template-columns: 1fr; gap: 24px; }
    .comparison__table-wrap::before { left: calc(50% + 1px); width: 27%; }
  }
</style>

{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY SHOP WITH US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built the way" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent colour)", "default": "shopping should feel" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A few concrete things we do differently, spelled out instead of left as a vague promise." },
    { "type": "text", "id": "us_label", "label": "Our column", "default": "Us" },
    { "type": "text", "id": "them_label", "label": "Comparison column", "default": "Others" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Free shipping, no minimum spend" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
