<style>
.announcement{position:relative;display:flex;align-items:center;justify-content:center;min-height:38px;padding:9px 20px}
.ann-item{display:none;text-align:center;font-size:12px;letter-spacing:.08em}
.ann-item.is-active{display:block;animation:ann-in .45s ease}
.ann-item a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.45);padding-bottom:1px}
.ann-item a:hover{border-bottom-color:#fff}
@keyframes ann-in{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.ann-item.is-active{animation:none}}
</style>
{%- if section.blocks.size > 0 -%}
<div class="announcement" data-announcement role="status" aria-live="polite">
  {%- for block in section.blocks -%}
    <span class="ann-item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
    </span>
  {%- endfor -%}
</div>
<script>
(function(){
  var bar=document.currentScript.previousElementSibling;
  if(!bar) return;
  var items=bar.querySelectorAll('.ann-item');
  if(items.length<2) return;
  var i=0;
  setInterval(function(){
    items[i].classList.remove('is-active');
    i=(i+1)%items.length;
    items[i].classList.add('is-active');
  },4000);
})();
</script>
{%- endif -%}
{% schema %}{"name":"Announcement bar","max_blocks":6,"settings":[],"blocks":[{"type":"message","name":"Message","settings":[{"type":"text","id":"text","label":"Text","default":"NEW IN - SHOP THE LATEST"},{"type":"url","id":"link","label":"Link (optional)"}]}],"presets":[{"name":"Announcement bar","blocks":[{"type":"message"},{"type":"message"},{"type":"message"}]}]}{% endschema %}
