{%- comment -%}
  Shop by category.

  Photography carries no baked-in text (safer to update, no typography
  risk from image generation), so the label renders as an HTML caption
  chip over the image instead.
{%- endcomment -%}

<section class="section"><div class="page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="grid categories">
    {%- for block in section.blocks -%}
      {%- assign col = collections[block.settings.collection] -%}
      {%- assign target = block.settings.link -%}
      {%- if target == blank and col != blank -%}{%- assign target = col.url -%}{%- endif -%}
      {%- assign label = block.settings.heading | default: col.title -%}
      {%- assign banner = col.metafields.custom.banner_image -%}

      <a class="category-card" href="{{ target | default: '/collections/all' }}" aria-label="{{ label | escape }}" {{ block.shopify_attributes }}>
        <div class="card-media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: label }}
          {%- elsif col.featured_image != blank -%}
            {{ col.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: label }}
          {%- elsif banner != blank -%}
            {%- if banner.type == 'file_reference' -%}
              <img src="{{ banner.value | image_url: width: 1200 }}" alt="{{ label | escape }}" loading="lazy" width="1200" height="1200">
            {%- else -%}
              <img src="{{ banner }}" alt="{{ label | escape }}" loading="lazy" width="1200" height="1200">
            {%- endif -%}
          {%- elsif col.products.first.featured_image != blank -%}
            {{ col.products.first.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: label }}
          {%- endif -%}
          <span class="category-card__label">{{ label }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div></section>

<style>
  .grid.categories .category-card{padding-bottom:0}
  .category-card .card-content{display:none}
  .category-card{position:relative}
  .category-card .card-media{position:relative}
  .category-card__label{
    position:absolute;left:14px;bottom:14px;z-index:1;
    background:#fff;color:var(--ink,#1a1a1a);
    font-family:var(--font-heading,'Poppins',Arial,sans-serif);
    font-weight:700;font-size:14px;letter-spacing:.01em;
    padding:9px 16px;border-radius:999px;
    box-shadow:0 2px 10px rgba(0,0,0,.12);
  }
  @media(max-width:560px){
    .category-card__label{font-size:12px;padding:7px 13px;left:10px;bottom:10px}
  }
</style>
{% schema %}{"name":"Category grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by category"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"heading","label":"Label (used for accessibility)","default":"Face"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Category grid","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
