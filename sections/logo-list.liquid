{%- comment -%}
  ============================================================
  LOGO LIST — tira de logos/selos de confiança
  ============================================================

  O QUE FAZ:
  Uma linha de logos (marcas parceiras, selos de imprensa, certificações)
  em escala de cinza sutil, que voltam à cor original no hover. Serve
  como prova social discreta, geralmente depois da vitrine de produtos.

  ONDE É USADA:
  Seção reutilizável (tem preset com 5 blocos) — comum na home.

  PRINCIPAIS PARTES:
  - section.blocks do tipo 'logo' (só uma imagem cada)

  OBSERVAÇÕES:
  Os logos ficam com a mesma altura (object-fit: contain), então
  imagens com proporções bem diferentes ainda ficam alinhadas.
{%- endcomment -%}
<div class="logo-list page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <p class="logo-list__heading">{{ section.settings.heading | escape }}</p>
  {%- endif -%}
  <ul class="logo-list__row" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
          {{ block.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'logo-list__image', alt: block.settings.alt | default: 'Logo' | escape }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'logo-list__image placeholder-svg' }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  .logo-list { padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }
  .logo-list__heading { text-align: center; font-size: var(--f0); letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.6; margin: 0 0 32px; }
  .logo-list__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .logo-list__image {
    height: 32px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .logo-list__image:hover { filter: grayscale(0); opacity: 1; }
</style>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
