{%- comment -%}
  Product card.

  Discount badge and compare-at price are both read from ONE variant
  (the one whose price is shown). Comparing the highest compare-at price
  in the product against the lowest price produced false claims such as
  "70% off" on a multi-pack, where no single option was ever 70% off.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign p = v.price
  assign cap = v.compare_at_price
  assign pct = 0
  if cap > p
    assign pct = cap | minus: p | times: 100 | divided_by: cap
  endif
-%}
<article class="product-card">
  <a href="{{ product.url }}">
    <div class="card-media">
      {%- if pct > 0 -%}<span class="save-badge">{{ pct }}% off</span>{%- endif -%}
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 700 }}"
          srcset="{{ product.featured_image | image_url: width: 350 }} 350w, {{ product.featured_image | image_url: width: 700 }} 700w"
          sizes="(max-width: 760px) 46vw, 24vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="700" height="700" loading="lazy">
      {%- else -%}
        <div class="placeholder">Product image</div>
      {%- endif -%}
    </div>
    <div class="card-content">
      <h3>{{ product.title }}</h3>
      <span class="price">{%- if product.price_varies -%}From {% endif %}{{ p | money }}</span>
      {%- if cap > p -%}<span class="compare">{{ cap | money }}</span>{%- endif -%}
    </div>
  </a>
</article>
