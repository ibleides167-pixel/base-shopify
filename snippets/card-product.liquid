{%- comment -%}
  ============================================================
  card-product — card de produto reutilizável
  ============================================================

  O QUE FAZ:
  Renderiza o card de um produto: imagem (com troca de imagem no hover se
  ativado nas settings), badge de desconto/esgotado, botão de quick-add
  (soma a variante padrão ao carrinho via AJAX, sem sair da página),
  swatches de cor (se o produto tiver uma opção chamada "Color"/"Cor"
  com swatch configurado no admin), vendor opcional, título e preço
  (via snippet 'price').

  COMO USAR:
  {% render 'card-product', card_product: product %}
  Dentro de um loop de coleção, por exemplo.

  PARÂMETROS:
  - card_product: objeto product a ser exibido no card.

  OBSERVAÇÕES:
  O aspect ratio da imagem vem de settings.card_image_ratio
  ('portrait', 'square' ou 'adapt'). A segunda imagem no hover depende de
  settings.card_show_second_image; o vendor depende de settings.card_show_vendor.
  O badge de desconto usa SEMPRE a mesma variante (selected_or_first_available)
  para calcular preço e preço comparativo — misturar a maior comparação com
  o menor preço do produto pode gerar um "% off" que nenhuma variante tem de fato.
  O botão de quick-add fica FORA do <a> (não pode existir <button> dentro de
  <a> — inválido em HTML e quebra leitor de tela), posicionado por cima da
  mídia via CSS. As swatches só aparecem com swatch de verdade configurado;
  sem isso, não inventamos uma cor que não existe.
{%- endcomment -%}
{%- liquid
  assign ratio = 1
  case settings.card_image_ratio
    when 'portrait'
      assign ratio = 0.75
    when 'square'
      assign ratio = 1
    when 'adapt'
      if card_product.featured_media
        assign ratio = card_product.featured_media.aspect_ratio
      endif
  endcase

  assign badge_variant = card_product.selected_or_first_available_variant
  assign badge_discount = 0
  if badge_variant.compare_at_price > badge_variant.price
    assign badge_discount = badge_variant.compare_at_price | minus: badge_variant.price | times: 100 | divided_by: badge_variant.compare_at_price
  endif

  assign color_option = nil
  for option in card_product.options_with_values
    if option.name contains 'Color' or option.name contains 'Cor'
      assign color_option = option
      break
    endif
  endfor
-%}
<div class="card-product">
  <a href="{{ card_product.url }}" class="card-product__link">
    <div class="card-product__media" style="padding-bottom: {{ 1 | divided_by: ratio | times: 100 }}%;">
      {%- if card_product.featured_media -%}
        {{
          card_product.featured_media
          | image_url: width: 720
          | image_tag:
            loading: 'lazy',
            class: 'card-product__image card-product__image--primary',
            widths: '180, 360, 540, 720',
            sizes: '(min-width: 1000px) 25vw, 50vw',
            alt: card_product.featured_media.alt | default: card_product.title | escape
        }}
        {%- if settings.card_show_second_image and card_product.media[1] -%}
          {{
            card_product.media[1]
            | image_url: width: 720
            | image_tag:
              loading: 'lazy',
              class: 'card-product__image card-product__image--secondary',
              widths: '180, 360, 540, 720',
              sizes: '(min-width: 1000px) 25vw, 50vw',
              alt: card_product.media[1].alt | default: card_product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'velkrova-product-serum.png' | asset_url | image_tag: loading: 'lazy', class: 'card-product__image' }}
      {%- endif -%}

      {%- if badge_discount > 0 -%}
        <span class="card-product__badge">{{ badge_discount }}% {{ 'products.product.on_sale' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="card-product__badge card-product__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>

    <div class="card-product__info">
      {%- if settings.card_show_vendor and card_product.vendor != blank -%}
        <span class="card-product__vendor">{{ card_product.vendor }}</span>
      {%- endif -%}
      <h3 class="card-product__title">{{ card_product.title | escape }}</h3>
      {% render 'price', product: card_product, use_variant: false, show_compare: true, price_class: 'price--card' %}
      {%- if color_option -%}
        <span class="card-product__swatches">
          {%- for value in color_option.values limit: 4 -%}
            <span class="card-product__swatch" style="background-color: {{ value.swatch.color | default: 'transparent' }};" title="{{ value | escape }}"></span>
          {%- endfor -%}
          {%- if color_option.values.size > 4 -%}
            <span class="card-product__swatch-more">+{{ color_option.values.size | minus: 4 }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </a>

  {%- if card_product.available -%}
    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-type="add-to-cart-form" class="card-product__quick-add">
      <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="card-product__quick-add-button" aria-label="{{ 'products.product.add_to_cart' | t }}">
        {% render 'icon', name: 'plus' %}
      </button>
    </form>
  {%- endif -%}
</div>
